# DatoCMS — Settings → API tokens → read-only token (używany przez samą stronę przy buildzie)
DATOCMS_API_TOKEN=

# DatoCMS — Content Management API token (pełny odczyt/zapis) — tylko do lokalnego
# zarządzania treścią/schematem, NIGDY nie używany w buildzie strony ani na Netlify
DATOCMS_CMA_TOKEN=

# --- Sklep (instrukcja: SKLEP.md). W Netlify: Site configuration → Environment variables;
# klucze testowe (sk_test_…) dla Deploy Previews, produkcyjne (sk_live_…) dla Production.

# true = lista produktów, podstrony i „Sklep online” w menu widoczne (koszyk działa zawsze)
PUBLIC_SHOP_PUBLISHED=false

# Stripe → Developers → API keys (Secret key)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint …/api/stripe-webhook → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# link logowania do portalu klienta (rezygnacja z subskrypcji): Settings → Billing → Customer portal
STRIPE_PORTAL_URL=

# losowy sekret do podpisywania linków do plików, min. 32 znaki:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_SECRET=

# e-maile po zakupie (resend.com, domena nataliafigas.pl zweryfikowana w DNS)
RESEND_API_KEY=
MAIL_FROM="Natalia Figas <sklep@nataliafigas.pl>"
# gdzie przychodzą powiadomienia o zamówieniach
NOTIFY_EMAIL=kontakt@nataliafigas.pl
