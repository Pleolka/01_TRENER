# DatoCMS — Settings → API tokens → read-only token (używany przez samą stronę przy buildzie)
DATOCMS_API_TOKEN=

# DatoCMS — Content Management API token (pełny odczyt/zapis) — tylko do lokalnego
# zarządzania treścią/schematem, NIGDY nie używany w buildzie strony ani na Netlify
DATOCMS_CMA_TOKEN=
