---
// Google Consent Mode v2: domyślnie wszystko odrzucone, GTM ładowany dopiero po zgodzie
// (statystyki → GA4, marketing → piksel Meta i Google Ads — tagi w GTM sprawdzają zgody).
// Bez PUBLIC_GTM_ID w ustawieniach Netlify żaden skrypt Google się nie ładuje.
import { CONSENT_STORAGE_KEY } from '../lib/consent';

const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
---

<script is:inline define:vars={{ gtmId, storageKey: CONSENT_STORAGE_KEY }}>
	/* eslint-disable prefer-rest-params, no-var -- skrypt w <head> bez bundlera; gtag musi wkładać do dataLayer obiekt arguments (wymóg Google) */
	window.dataLayer = window.dataLayer || [];
	window.gtag = function () {
		window.dataLayer.push(arguments);
	};
	window.gtag('consent', 'default', {
		ad_storage: 'denied',
		ad_user_data: 'denied',
		ad_personalization: 'denied',
		analytics_storage: 'denied',
	});

	window.loadGtm = function () {
		if (!gtmId || window.gtmLoaded) return;
		window.gtmLoaded = true;
		window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
		var script = document.createElement('script');
		script.async = true;
		script.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
		document.head.appendChild(script);
	};

	// zapisany wybór (JSON { analytics, marketing }) — przywracany przed GTM,
	// żeby tagi od razu znały zgody. GTM ładuje się, gdy jest choć jedna zgoda.
	var choice = null;
	try {
		choice = JSON.parse(localStorage.getItem(storageKey) || 'null');
	} catch {
		choice = null;
	}
	if (choice && (choice.analytics || choice.marketing)) {
		var ads = choice.marketing ? 'granted' : 'denied';
		window.gtag('consent', 'update', {
			analytics_storage: choice.analytics ? 'granted' : 'denied',
			ad_storage: ads,
			ad_user_data: ads,
			ad_personalization: ads,
		});
		window.loadGtm();
	}
</script>
