---
// Okno zgody: karta w lewym dolnym rogu. Tytuł, krótki opis, lista zgód (niezbędne zawsze
// włączone, statystyki do wyboru) i dwa przyciski: „Akceptuję wszystkie” albo „Zapisz wybór”
// (bez zaznaczenia = tylko niezbędne). Link „Ustawienia cookies” w stopce otwiera okno ponownie.
---

<div class="cookie-banner" role="dialog" aria-live="polite" aria-labelledby="cookie-banner-title" hidden data-cookie-banner>
	<form class="cookie-inner" data-cookie-panel>
		<p class="cookie-title" id="cookie-banner-title">Pliki cookies</p>
		<p class="cookie-text">
			Pomóż mi ulepszać stronę — statystyki pokazują, które treści są przydatne. Bez zgody działają tylko pliki niezbędne.
			Szczegóły w <a href="/polityka-prywatnosci">polityce prywatności</a>.
		</p>

		<ul class="cookie-options">
			<li>
				<label class="cookie-option">
					<input type="checkbox" checked disabled />
					<span>
						<strong class="cookie-option-label">Niezbędne</strong>
						<span class="cookie-option-text">zawsze włączone: zapamiętanie tego wyboru i działanie formularzy</span>
					</span>
				</label>
			</li>
			<li>
				<label class="cookie-option">
					<input type="checkbox" name="analytics" />
					<span>
						<strong class="cookie-option-label">Statystyki</strong>
						<span class="cookie-option-text">Google Analytics: które strony są czytane i skąd przychodzą odwiedzający</span>
					</span>
				</label>
			</li>
		</ul>

		<div class="cookie-actions">
			<button class="cookie-button cookie-save" type="submit">Zapisz wybór</button>
			<button class="cookie-button cookie-accept" type="button" data-consent="granted">Akceptuję wszystkie</button>
		</div>
	</form>
</div>

<script>
	import { CONSENT_STORAGE_KEY, type Consent } from '../lib/consent';

	const banner = document.querySelector<HTMLElement>('[data-cookie-banner]')!;
	const panel = banner.querySelector<HTMLFormElement>('[data-cookie-panel]')!;
	const analytics = panel.querySelector<HTMLInputElement>('input[name="analytics"]')!;

	const read = (): Consent | null => {
		try {
			return localStorage.getItem(CONSENT_STORAGE_KEY) as Consent | null;
		} catch {
			return null;
		}
	};

	const save = (value: Consent) => {
		try {
			localStorage.setItem(CONSENT_STORAGE_KEY, value);
		} catch {}
		window.gtag('consent', 'update', { analytics_storage: value });
		if (value === 'granted') window.loadGtm();
		banner.hidden = true;
	};

	const open = () => {
		analytics.checked = read() === 'granted';
		banner.hidden = false;
	};

	// Przy pierwszej wizycie okno wysuwa się po chwili — strona zdąży się załadować, a ruch przyciąga wzrok.
	const FIRST_SHOW_DELAY_MS = 1000;
	if (!read()) window.setTimeout(open, FIRST_SHOW_DELAY_MS);

	banner.querySelector<HTMLButtonElement>('[data-consent="granted"]')!.addEventListener('click', () => save('granted'));
	panel.addEventListener('submit', (event) => {
		event.preventDefault();
		save(analytics.checked ? 'granted' : 'denied');
	});
	document.querySelectorAll('[data-cookie-settings]').forEach((el) => el.addEventListener('click', open));
</script>

<style>
	/* karta w lewym dolnym rogu, tło prawie pełne (minimalna przezroczystość) */
	.cookie-banner {
		position: fixed;
		left: 1rem;
		bottom: 1rem;
		z-index: 100;
		width: min(26rem, calc(100vw - 2rem));
		max-height: calc(100dvh - 2rem);
		overflow-y: auto;
		padding: 1.5rem;
		background: rgba(2, 0, 36, 0.94);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
	}

	.cookie-banner[hidden] {
		display: none;
	}

	/* wysunięcie od dołu z lekkim pojawieniem (bez animacji, gdy użytkownik ogranicza ruch) */
	@media (prefers-reduced-motion: no-preference) {
		.cookie-banner:not([hidden]) {
			animation: cookie-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
		}
	}

	@keyframes cookie-in {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
	}

	.cookie-inner {
		display: grid;
		gap: 1rem;
	}

	.cookie-title {
		font-family: var(--font-family-heading);
		font-size: 1.25rem;
		font-weight: var(--font-weight-h);
		color: var(--color-white);
	}

	.cookie-text {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-font);
	}

	.cookie-text a {
		color: var(--color-energy);
	}

	/* lista zgód oddzielona od opisu cienką linią */
	.cookie-options {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 1rem 0 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.cookie-option {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.75rem;
		align-items: start;
		cursor: pointer;
	}

	.cookie-option-label {
		display: block;
		font-size: 15px;
		font-weight: 600;
		color: var(--color-white);
	}

	.cookie-option-text {
		display: block;
		font-size: 14px;
		line-height: 1.45;
		color: var(--color-muted);
	}

	/* checkbox: ramka w kolorze energy; zaznaczony — wypełnienie z ciemnym ptaszkiem */
	.cookie-option input {
		position: relative;
		width: 1.15rem;
		height: 1.15rem;
		margin: 0.1rem 0 0;
		appearance: none;
		background: transparent;
		border: 1px solid var(--color-energy);
		border-radius: 3px;
		cursor: pointer;
	}

	.cookie-option input:checked {
		background: var(--color-energy);
	}

	.cookie-option input:checked::after {
		content: '';
		position: absolute;
		left: 0.33rem;
		top: 0.1rem;
		width: 0.3rem;
		height: 0.6rem;
		border-right: 2px solid var(--color-on-energy);
		border-bottom: 2px solid var(--color-on-energy);
		transform: rotate(45deg);
	}

	.cookie-option input:disabled {
		opacity: 0.5;
		cursor: default;
	}

	.cookie-option input:focus-visible {
		outline: 2px solid var(--color-energy);
		outline-offset: 2px;
	}

	/* dwa przyciski obok siebie, równej szerokości */
	.cookie-actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.cookie-button {
		min-height: 44px;
		padding: 0.5rem 0.75rem;
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.2;
		border-radius: var(--radius-button);
		cursor: pointer;
		transition:
			background 0.2s ease,
			color 0.2s ease,
			filter 0.2s ease;
	}

	.cookie-save {
		color: var(--btn-outline-color);
		background: transparent;
		border: var(--btn-outline-width) solid var(--btn-outline-color);
	}

	.cookie-save:hover {
		color: var(--color-on-energy);
		background: var(--btn-outline-color);
	}

	/* „Akceptuję wszystkie” jako najbardziej wyrazisty element okna */
	.cookie-accept {
		color: var(--color-on-energy);
		background: var(--gradient-button);
		border: none;
	}

	.cookie-accept:hover {
		filter: brightness(1.08);
	}
</style>
