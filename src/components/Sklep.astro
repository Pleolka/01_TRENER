---
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import SectionBadge from './ui/SectionBadge.astro';

const FALLBACK_OFFERS = [
	{
		path: '/konsultacje-z-trenerem-personalnym',
		title: 'Konsultacje z trenerem personalnym',
		description: 'Indywidualna konsultacja dopasowana do Twojego celu.',
	},
	{
		path: '/online-coaching',
		title: 'Online coaching',
		description: 'Program prowadzony zdalnie, krok po kroku.',
		badge: 'Wstrzymane',
	},
	{
		path: '/mocny-brzuch-w-6-tygodni',
		title: 'Mocny brzuch w 6 tygodni',
		description: 'Sześciotygodniowy plan treningowy na siłę i stabilizację.',
	},
	{
		path: '/lekka-redukcja',
		title: 'Lekka redukcja',
		description: 'Łagodny plan redukcji tkanki tłuszczowej bez restrykcji.',
	},
];

interface Props {
	offers?: { path: string; title: string; description: string; badge?: string | null }[];
}

const { offers: offersProp } = Astro.props;
const offers = offersProp && offersProp.length > 0 ? offersProp : FALLBACK_OFFERS;

const ICONS: Record<string, string> = {
	'/konsultacje-z-trenerem-personalnym':
		'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z|m9 12 2 2 4-4',
	'/online-coaching': 'M2 3h20a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z|M8 21h8|M12 17v4',
	'/mocny-brzuch-w-6-tygodni':
		'M12 12m-10 0a10 10 0 1 0 20 0a10 10 0 1 0 -20 0|M12 12m-6 0a6 6 0 1 0 12 0a6 6 0 1 0 -12 0|M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0',
	'/lekka-redukcja': 'M12 3v12|m7 10 5 5 5-5|M5 21h14',
};
const FALLBACK_ICON = 'M12 3v12|m7 10 5 5 5-5|M5 21h14';
---

<SiteChrome>
	<Section pt={5} pb={3}>
		<Container>
			<div class="header">
				<SectionBadge text="Sklep" />
				<h1 class="title">Sprawdzone <span class="accent">procedury</span> dla Twojego zdrowia</h1>
			</div>
		</Container>
	</Section>

	<Section pt={2} pb={6} bgcolor="var(--color-white)">
		<Container>
			<div class="grid">
				{
					offers.map((offer) => (
						<a class="card" href={offer.path}>
							<span class="card-icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									{(ICONS[offer.path] || FALLBACK_ICON).split('|').map((d) => (
										<path d={d} />
									))}
								</svg>
							</span>
							{offer.badge && <span class="card-badge">{offer.badge}</span>}
							<h2>{offer.title}</h2>
							<p>{offer.description}</p>
						</a>
					))
				}
			</div>
		</Container>
	</Section>
</SiteChrome>

<style>
	.header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.accent {
		color: var(--color-base);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.25rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.card:hover {
		border-color: var(--color-border-strong);
		transform: translateY(-2px);
	}

	.card-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.75rem;
		background: var(--color-surface);
		color: var(--color-base);
	}

	.card-icon svg {
		width: 1.4rem;
		height: 1.4rem;
	}

	/* karta w gridzie ma być mniejsza niż domyślna skala h2/p ze
	   wspólnego systemu — tak jak w WELDMET Card.js nadpisuje
	   globalne rozmiary lokalnie tam, gdzie hierarchia treści tego wymaga */
	.card h2 {
		font-size: 1.1rem;
		line-height: 1.3;
	}

	.card p {
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--color-muted);
	}

	.card-badge {
		align-self: flex-start;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 600;
	}
</style>
