---
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import SectionBadge from './ui/SectionBadge.astro';

const FALLBACK_OFFERS = [
	{
		path: '/konsultacje-z-trenerem-personalnym',
		title: 'Konsultacje z trenerem personalnym',
		description: 'Indywidualna konsultacja dopasowana do Twojego celu.',
	},
	{
		path: '/online-coaching',
		title: 'Online coaching',
		description: 'Program prowadzony zdalnie, krok po kroku.',
		badge: 'Wstrzymane',
	},
	{
		path: '/mocny-brzuch-w-6-tygodni',
		title: 'Mocny brzuch w 6 tygodni',
		description: 'Sześciotygodniowy plan treningowy na siłę i stabilizację.',
	},
	{
		path: '/lekka-redukcja',
		title: 'Lekka redukcja',
		description: 'Łagodny plan redukcji tkanki tłuszczowej bez restrykcji.',
	},
];

interface Props {
	offers?: { path: string; title: string; description: string; badge?: string | null }[];
}

const { offers: offersProp } = Astro.props;
const offers = offersProp && offersProp.length > 0 ? offersProp : FALLBACK_OFFERS;
---

<SiteChrome>
	<Section pt={5} pb={6}>
		<Container>
			<div class="header">
				<SectionBadge text="Sklep" />
				<h1 class="title">Sprawdzone <span class="accent">procedury</span> dla Twojego zdrowia</h1>
			</div>
			<div class="grid">
				{
					offers.map((offer) => (
						<a class="card" href={offer.path}>
							{offer.badge && <span class="card-badge">{offer.badge}</span>}
							<h2>{offer.title}</h2>
							<p>{offer.description}</p>
						</a>
					))
				}
			</div>
		</Container>
	</Section>
</SiteChrome>

<style>
	.header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.accent {
		color: var(--color-base);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.25rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.card:hover {
		border-color: var(--color-border-strong);
		transform: translateY(-2px);
	}

	/* karta w gridzie ma być mniejsza niż domyślna skala h2/p ze
	   wspólnego systemu — tak jak w WELDMET Card.js nadpisuje
	   globalne rozmiary lokalnie tam, gdzie hierarchia treści tego wymaga */
	.card h2 {
		font-size: 1.1rem;
		line-height: 1.3;
	}

	.card p {
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--color-muted);
	}

	.card-badge {
		align-self: flex-start;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 600;
	}
</style>
