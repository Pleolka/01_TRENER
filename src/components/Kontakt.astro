---
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import SectionBadge from './ui/SectionBadge.astro';
import { info } from '../assets/data/kontakt';
import { accent } from '../lib/accent';

interface Props {
	heroBg?: string;
	heroAspect?: number;
	badge?: string | null;
	heading?: string | null;
	text?: string | null;
	formHeading?: string | null;
}

const {
	badge = 'TRENING | DIETA | ZDROWE ŻYCIE',
	heading = 'Skontaktuj się ze mną, jestem tutaj dla Ciebie!',
	text = 'Masz pytania dotyczące treningów personalnych, prowadzenia online lub moich e-booków? Napisz do mnie bezpośrednio – wspólnie zaplanujemy drogę do Twojego celu.',
	formHeading = 'Wypełnij formularz',
} = Astro.props;
---

<SiteChrome heroBg={Astro.props.heroBg} heroAspect={Astro.props.heroAspect}>
	<Section pt={5} pb={6}>
		<Container>
			<div class="contact-layout">
			<div class="intro">
				{badge && <SectionBadge text={badge} />}
				<h1 set:html={accent(heading ?? '')} />
				{text && <p class="subtitle">{text}</p>}
				<p class="mail">E-mail <a href={`mailto:${info.mail}`}>{info.mail}</a></p>
			</div>

			<div class="form-block">
			{formHeading && <h2 class="form-title">{formHeading}</h2>}
			<form
				class="contact-form"
				name="kontakt"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				action="/dziekujemy"
			>
				<input type="hidden" name="form-name" value="kontakt" />
				<p class="honeypot">
					<label>
						Nie wypełniaj tego pola
						<input name="bot-field" />
					</label>
				</p>

				<div class="field">
					<label for="imie">Imię</label>
					<input type="text" id="imie" name="imie" autocomplete="name" required />
				</div>

				<div class="field">
					<label for="email">Email</label>
					<input type="email" id="email" name="email" autocomplete="email" required />
				</div>

				<div class="field">
					<label for="wiadomosc">Wiadomość</label>
					<textarea
						id="wiadomosc"
						name="wiadomosc"
						rows="5"
						placeholder="Napisz w czym mogę Ci pomóc."
						required
					></textarea>
				</div>

				<button type="submit" class="submit-btn">Wyślij wiadomość</button>
			</form>
			</div>
			</div>
		</Container>
	</Section>
</SiteChrome>

<style>
	/* dwie kolumny na szerokość kontenera; na węższych ekranach jedna pod drugą */
	.contact-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}

	@media (max-width: 900px) {
		.contact-layout {
			grid-template-columns: 1fr;
		}
	}

	.intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.mail a {
		color: var(--color-accent);
	}

	.form-title {
		margin-bottom: 1.5rem;
	}

	.accent {
		color: var(--color-energy);
	}

	.subtitle {
		color: var(--color-muted);
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.honeypot {
		position: absolute;
		left: -9999px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.field label {
		font-weight: 600;
		color: var(--color-font);
	}

	.field input,
	.field textarea {
		font: inherit;
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: var(--color-surface);
		color: var(--color-font);
		resize: vertical;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	.submit-btn {
		align-self: center;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;
		padding: 0 3rem;
		border-radius: var(--radius-button);
		border: none;
		background: var(--gradient-button);
		color: var(--color-on-energy);
		font-weight: 600;
		font-size: 18px;
		cursor: pointer;
		transition: filter 0.3s ease;
	}

	.submit-btn:hover {
		filter: brightness(0.9);
	}
</style>
