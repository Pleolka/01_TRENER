---
// Odpowiednik Container/ContainerMob z WELDMET (src/utils/utils.js).
interface Props {
	mt?: string;
	mb?: string;
	mtMobile?: string;
}

// domyślnie bez marginesów — pionowy odstęp daje Section (--section-py)
const { mt = '0', mb = '0', mtMobile } = Astro.props;

const style = [`--mt:${mt}`, `--mb:${mb}`, mtMobile ? `--mt-mobile:${mtMobile}` : '']
	.filter(Boolean)
	.join(';');
---

<div class="container" style={style}>
	<slot />
</div>

<style>
	/* jeden płynny kontener: pełna szerokość minus margines po bokach,
	   maksymalnie --container-max (tokens.css) */
	.container {
		width: min(100% - 2 * var(--container-gutter), var(--container-max));
		margin-inline: auto;
		margin-top: var(--mt);
		margin-bottom: var(--mb);
		position: relative;
		z-index: 10;
	}

	@media (max-width: 979px) {
		.container {
			margin-top: var(--mt-mobile, var(--mt));
		}
	}
</style>
