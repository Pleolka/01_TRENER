---
// Uproszczony odpowiednik Button.js z WELDMET — bez Gatsby Link
// i stanu "loading" (niepotrzebne na statycznej stronie), z dwoma
// wariantami zamiast pięciu (base, outline). Kolejne warianty dokłada
// się tak samo: nowa klasa .btn--nazwa poniżej.
interface Props {
  href: string;
  variant?: "base" | "outline";
  /* sm — mniejszy przycisk, np. dwa obok siebie na karcie produktu */
  size?: "md" | "sm";
  target?: string;
}

const { href: raw, variant = "base", size = "md", target: targetProp } = Astro.props;

// adresy wpisywane w CMS-ie: „kontakt” → „/kontakt”, „www.x.pl” → „https://www.x.pl”;
// /ścieżka, #sekcja, https://…, mailto: i tel: zostają bez zmian
const value = raw.trim();
const href = /^([/#?]|[a-z][a-z0-9+.-]*:)/i.test(value)
  ? value
  : value.startsWith("www.")
    ? `https://${value}`
    : `/${value}`;

// link do innej strony otwiera się w nowej karcie
const external = /^https?:\/\//i.test(href) && !href.startsWith(Astro.site?.origin ?? "\0");
const target = targetProp ?? (external ? "_blank" : undefined);
---

<a
  class:list={["btn", `btn--${variant}`, { "btn--sm": size === "sm" }]}
  href={href}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 3rem;
    border-radius: var(--radius-button);
    text-decoration: none;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.1;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      filter 0.3s ease,
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  /* telefony: mniejszy przycisk (wysokość 44px — wygodna dla palca) */
  @media (max-width: 575px) {
    .btn {
      display: flex;
      width: 100%;
      max-width: var(--btn-mobile-width);
      margin-inline: auto;
      min-height: 44px;
      padding: 0 1.5rem;
      font-size: 16px;
    }
  }

  .btn--sm {
    min-height: 38px;
    padding: 0 1.1rem;
    font-size: 15px;
  }

  .btn--base {
    color: var(--color-on-energy);
    background: var(--gradient-button);
    border: none;
    box-shadow: var(--glow-energy);
  }

  .btn--base:hover {
    transform: translateY(-2px);
    box-shadow: var(--glow-energy-hover);
    filter: brightness(1.08);
  }

  .btn--outline {
    color: var(--btn-outline-color);
    background: transparent;
    border: var(--btn-outline-width) solid var(--btn-outline-color);
  }

  .btn--outline:hover {
    color: var(--color-on-energy);
    background: var(--btn-outline-color);
    box-shadow: var(--glow-energy);
    transform: translateY(-2px);
  }
</style>
