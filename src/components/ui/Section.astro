---
// Sekcja strony: tło + odstęp pionowy. Domyślnie odstęp ze skali
// (--section-py w tokens.css), jednakowy na wszystkich podstronach.
// pt / pb — tylko wyjątki: liczba = rem, tekst = dowolna wartość CSS
// (np. 0 pod zdjęciem stojącym na krawędzi albo var(--space-content)).
interface Props {
	pt?: number | string;
	pb?: number | string;
	bgcolor?: string;
	mt?: string;
	mb?: string;
}

const { pt, pb, bgcolor = 'transparent', mt = '0', mb = '0' } = Astro.props;

const space = (v: number | string | undefined) =>
	v === undefined ? 'var(--section-py)' : typeof v === 'number' ? `${v}rem` : v;

const style = [`--pt:${space(pt)}`, `--pb:${space(pb)}`, `--bgcolor:${bgcolor}`, `--mt:${mt}`, `--mb:${mb}`].join(
	';',
);
---

<section class="section" style={style}>
	<slot />
</section>

<style>
	.section {
		padding-top: var(--pt);
		padding-bottom: var(--pb);
		background: var(--bgcolor);
		margin-top: var(--mt);
		margin-bottom: var(--mb);
		position: relative;
	}

</style>
