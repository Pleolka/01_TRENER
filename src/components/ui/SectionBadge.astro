---
// Mały "pill badge" nad nagłówkami sekcji — ikona marki + tekst + ikona marki,
// wzorowany na wzorcu klientki (lotus-badge), ale z naszą magenta ikonką z favicony.
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<span class="section-badge">
	<img src="/favicon.svg" alt="" width="14" height="14" />
	<span>{text}</span>
	<img src="/favicon.svg" alt="" width="14" height="14" />
</span>

<style>
	.section-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 1.1rem;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-font);
	}

	.section-badge img {
		display: block;
		flex-shrink: 0;
	}
</style>
