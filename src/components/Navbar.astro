---
import { list as navItems } from "../assets/data/strukturaStrony";
import { Image } from "astro:assets";
import logo from "../images/Logo.webp";
import Container from "./ui/Container.astro";

const links = navItems.filter((item) => !item.cta);
const cta = navItems.find((item) => item.cta);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
// aktywna też na podstronach sekcji, np. /blog/<wpis> podświetla „Blog”
const isActive = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<div class="navbar">
  <Container mt="0" mb="0" mtMobile="0">
  <header class="bar">
    <a class="logo" href="/">
      <Image src={logo} alt="Natalia Figas" height={54} densities={[1, 2]} loading="eager" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Otwórz menu" />
    <label for="nav-toggle" class="nav-toggle-label">
      <span></span>
    </label>

    <nav class="nav">
      <div class="nav-links">
        {
          links.map((item) => (
            <a
              href={item.path}
              class:list={["nav-link", { active: isActive(item.path) }]}
            >
              {item.name}
            </a>
          ))
        }
      </div>

      {
        cta && (
          <a class="nav-cta" href={cta.path}>
            {cta.name}
          </a>
        )
      }
    </nav>
  </header>
  </Container>
</div>

<script>
  const navbar = document.querySelector(".navbar");
  const update = () => navbar?.classList.toggle("scrolled", window.scrollY > 10);
  update();
  window.addEventListener("scroll", update, { passive: true });
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    /* delikatne przyciemnienie kolorem tła strony (--color-page) —
       tło hero przebija, ale pasek odcina się od niego */
    background: rgba(2, 0, 36, 0.5);
    border-bottom: 1px solid var(--color-border);
    transition:
      background 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  /* po przewinięciu treść przesuwa się pod paskiem — mocniejsze
     przyciemnienie i rozmycie trzymają czytelność linków */
  .navbar.scrolled {
    background: rgba(2, 0, 36, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0;
    transition: padding 0.25s ease;
  }

  .navbar.scrolled .bar {
    padding: 0.4rem 0;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo img {
    height: 3.4rem;
    width: auto;
    display: block;
    transition: height 0.25s ease;
  }

  .navbar.scrolled .logo img {
    height: 2.4rem;
  }

  .nav {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    /* rośnie z szerokością ekranu: 1.5rem na węższych, do 3rem na szerokich */
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .nav-link {
    color: var(--color-white);
    text-decoration: none;
    font-size: var(--font-size-p);
    font-weight: 400;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* hover tylko zmienia kolor — bez zmiany grubości, żeby menu nie skakało */
  .nav-link:hover {
    color: var(--color-energy);
  }

  /* bieżąca podstrona: kolor energy i pełna grubość */
  .nav-link.active {
    color: var(--color-energy);
    font-weight: 600;
  }

  .nav-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-button);
    /* wersja obrysowa — jak Button variant="outline" */
    background: transparent;
    border: var(--btn-outline-width) solid var(--btn-outline-color);
    color: var(--btn-outline-color);
    font-size: var(--font-size-p);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--btn-outline-color);
    color: var(--color-on-energy);
    box-shadow: var(--glow-energy);
  }

  .nav-toggle {
    display: none;
  }

  .nav-toggle-label {
    margin-right: 1rem;
    display: none;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .nav-toggle-label span,
  .nav-toggle-label span::before,
  .nav-toggle-label span::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--color-white);
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .nav-toggle-label span {
    position: relative;
  }

  .nav-toggle-label span::before,
  .nav-toggle-label span::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .nav-toggle-label span::before {
    top: -6px;
  }

  .nav-toggle-label span::after {
    top: 6px;
  }

  .nav-toggle:checked ~ .nav-toggle-label span {
    background: transparent;
  }

  .nav-toggle:checked ~ .nav-toggle-label span::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle:checked ~ .nav-toggle-label span::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 640px) {
    .nav-toggle-label {
      display: flex;
      margin-left: auto;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: calc(-1 * var(--container-gutter));
      right: calc(-1 * var(--container-gutter));
      flex-direction: column;
      align-items: center;
      gap: 0;
      padding: 0 0 1.25rem;
      background: var(--color-page);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-cta {
      width: 100%;
      max-width: var(--btn-mobile-width);
      min-height: 44px;
      margin-top: 1.25rem;
      font-size: 16px;
    }

    /* pozycje menu: pełna szerokość, oddzielone liniami — klikalny cały pas,
       nie tylko napis */
    .nav-links {
      flex-direction: column;
      align-self: stretch;
      gap: 0;
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: 1.1rem 1rem;
      text-align: center;
      border-bottom: 1px solid var(--color-border);
    }

    .nav-link,
    .nav-link.active {
      font-weight: 700;
    }

    /* bieżąca podstrona: delikatnie jaśniejszy pas */
    .nav-link.active {
      background: rgba(193, 232, 255, 0.07);
    }

    .nav-link:active {
      background: rgba(193, 232, 255, 0.1);
    }

    .nav-toggle:checked ~ .nav {
      display: flex;
    }
  }
</style>
