---
import { list as navItems, SHOP_PUBLISHED } from "../assets/data/strukturaStrony";
import cartIcon from "@phosphor-icons/core/assets/regular/shopping-bag.svg?raw";
import Logo from "../images/logo.svg";
import Container from "./ui/Container.astro";

const links = navItems.filter((item) => !item.cta);
const cta = navItems.find((item) => item.cta);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
// aktywna też na podstronach sekcji, np. /blog/<wpis> podświetla „Blog”
const isActive = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<div class="navbar">
  <Container mt="0" mb="0" mtMobile="0">
  <header class="bar">
    <a class="logo" href="/" aria-label="Natalia Figas">
      <Logo aria-hidden="true" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Otwórz menu" />
    <label for="nav-toggle" class="nav-toggle-label">
      <span></span>
    </label>

    <nav class="nav">
      <div class="nav-links">
        {
          links.map((item) => (
            <a
              href={item.path}
              class:list={["nav-link", { active: isActive(item.path) }]}
            >
              {item.name}
            </a>
          ))
        }
      </div>

      {
        cta && (
          <a class="nav-cta" href={cta.path}>
            {cta.name}
          </a>
        )
      }
    </nav>

    {
      SHOP_PUBLISHED && (
        <a class="cart-link" href="/koszyk" aria-label="Koszyk" data-cart-link>
          <span class="cart-icon" set:html={cartIcon} />
          <span class="cart-count" data-cart-count hidden>0</span>
        </a>
      )
    }
  </header>
  </Container>
</div>

<script>
  const navbar = document.querySelector<HTMLElement>(".navbar");
  const bar = document.querySelector<HTMLElement>(".bar");
  const toggle = document.querySelector<HTMLInputElement>("#nav-toggle");
  const update = () => navbar?.classList.toggle("scrolled", window.scrollY > 10);
  update();
  window.addEventListener("scroll", update, { passive: true });

  // menu mobilne: zajmuje cały ekran pod paskiem — wysokość liczona od dołu
  // paska (pasek zmienia wysokość po przewinięciu)
  const setOffset = () => {
    if (bar && navbar) navbar.style.setProperty("--nav-offset", `${bar.getBoundingClientRect().bottom}px`);
  };
  const close = () => {
    if (toggle) toggle.checked = false;
  };
  toggle?.addEventListener("change", setOffset);
  window.addEventListener("resize", () => {
    setOffset();
    // po obróceniu / poszerzeniu ekranu do wersji desktopowej menu się zamyka
    if (window.matchMedia("(min-width: 1100px)").matches) close();
  });
  // kliknięcie pozycji menu (także kotwicy na tej samej stronie) i Escape zamykają menu
  document.querySelectorAll(".nav a").forEach((link) => link.addEventListener("click", close));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>

<script>
  import { initCart } from "../scripts/cart";
  initCart();
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    /* delikatne przyciemnienie kolorem tła strony (--color-page) —
       tło hero przebija, ale pasek odcina się od niego */
    background: rgba(2, 0, 36, 0.5);
    border-bottom: 1px solid var(--color-border);
    transition:
      background 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  /* po przewinięciu treść przesuwa się pod paskiem — mocniejsze
     przyciemnienie i rozmycie trzymają czytelność linków */
  .navbar.scrolled {
    background: rgba(2, 0, 36, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0;
    transition: padding 0.25s ease;
  }

  .navbar.scrolled .bar {
    padding: 0.4rem 0;
  }

  /* otwarte menu mobilne: pełne tło paska i blokada przewijania strony pod spodem */
  .navbar:has(.nav-toggle:checked) {
    background: var(--color-page);
  }

  :global(html:has(#nav-toggle:checked)) {
    overflow: hidden;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    /* mniejszy odstęp pod logo; wysokość paska i położenie przycisków bez zmian */
    transform: translateY(0.4rem);
    transition: transform 0.25s ease;
  }

  .navbar.scrolled .logo {
    transform: none;
  }

  .logo :global(svg) {
    height: 4.5rem;
    width: auto;
    aspect-ratio: 2222 / 892;
    display: block;
    /* grafika dochodzi do samej krawędzi pliku — bez tego krzywe by się ścinały */
    overflow: visible;
    transition: height 0.25s ease;
  }

  .navbar.scrolled .logo :global(svg) {
    height: 3.2rem;
  }

  .nav {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    /* rośnie z szerokością ekranu: 1.5rem na węższych, do 3rem na szerokich */
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .nav-link {
    color: var(--color-white);
    text-decoration: none;
    /* Barlow Light — podobny do Bahnschrift z „NATI” w logo, ale dostarczany
       ze stroną, więc wygląda tak samo na każdym urządzeniu */
    font-family: "Barlow", var(--font-family-body);
    font-size: var(--font-size-p);
    font-weight: 300;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* hover tylko zmienia kolor — bez zmiany grubości, żeby menu nie skakało */
  .nav-link:hover {
    color: var(--color-energy);
  }

  /* bieżąca podstrona: kolor energy i pełna grubość */
  .nav-link.active {
    color: var(--color-energy);
    font-weight: 700;
  }

  .nav-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-button);
    /* wersja obrysowa — jak Button variant="outline" */
    background: transparent;
    border: var(--btn-outline-width) solid var(--btn-outline-color);
    color: var(--btn-outline-color);
    font-size: var(--font-size-p);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--btn-outline-color);
    color: var(--color-on-energy);
    box-shadow: var(--glow-energy);
  }

  .nav-toggle {
    display: none;
  }

  /* ikona koszyka z licznikiem — tylko gdy sklep jest widoczny */
  .cart-link {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-white);
    transition: color 0.2s ease;
  }

  .cart-link:hover {
    color: var(--color-energy);
  }

  .cart-icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
  }

  .cart-count {
    position: absolute;
    top: 0.1rem;
    right: 0;
    min-width: 1.2rem;
    height: 1.2rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--color-energy);
    color: var(--color-on-energy);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2rem;
    text-align: center;
  }

  .cart-count[hidden] {
    display: none;
  }

  .nav-toggle-label {
    margin-right: 1rem;
    display: none;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .nav-toggle-label span,
  .nav-toggle-label span::before,
  .nav-toggle-label span::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--color-white);
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .nav-toggle-label span {
    position: relative;
  }

  .nav-toggle-label span::before,
  .nav-toggle-label span::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .nav-toggle-label span::before {
    top: -6px;
  }

  .nav-toggle-label span::after {
    top: 6px;
  }

  .nav-toggle:checked ~ .nav-toggle-label span {
    background: transparent;
  }

  .nav-toggle:checked ~ .nav-toggle-label span::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle:checked ~ .nav-toggle-label span::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* poniżej tej szerokości menu nie mieści się w jednym wierszu */
  @media (max-width: 1099px) {
    .nav-toggle-label {
      display: flex;
      margin-left: auto;
    }

    /* koszyk obok hamburgera, po prawej */
    .cart-link {
      order: 1;
      margin-left: auto;
    }

    .bar:has(.cart-link) .nav-toggle-label {
      order: 2;
      margin-left: 0.5rem;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: calc(-1 * var(--container-gutter));
      right: calc(-1 * var(--container-gutter));
      /* na cały ekran pod paskiem; przy niskim ekranie przewija się samo menu */
      height: calc(100dvh - var(--nav-offset, 5.5rem));
      overflow-y: auto;
      overscroll-behavior: contain;
      flex-direction: column;
      align-items: center;
      gap: 0;
      padding: 0 0 2rem;
      background: var(--color-page);
    }

    .nav-cta {
      width: 100%;
      max-width: var(--btn-mobile-width);
      min-height: 44px;
      margin-top: 1.25rem;
      font-size: 16px;
    }

    /* pozycje menu: pełna szerokość, oddzielone liniami — klikalny cały pas,
       nie tylko napis */
    .nav-links {
      flex: 0 0 auto;
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-self: stretch;
      gap: 0;
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: 1.1rem 1rem;
      text-align: center;
      border-bottom: 1px solid var(--color-border);
    }

    /* bieżąca podstrona: delikatnie jaśniejszy pas */
    .nav-link.active {
      background: rgba(193, 232, 255, 0.07);
    }

    .nav-link:active {
      background: rgba(193, 232, 255, 0.1);
    }

    .nav-toggle:checked ~ .nav {
      display: flex;
    }
  }
</style>
