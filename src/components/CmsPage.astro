---
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import SectionBadge from './ui/SectionBadge.astro';
import { accent } from '../lib/accent';

// Strona z nagłówkiem i treścią HTML — używana przez wpisy bloga.
interface Props {
	heading: string;
	eyebrow?: string;
	badge?: string | null;
	/* zajawka pod tytułem */
	lead?: string | null;
	/* spis treści z nagłówków H2 — na szerokich ekranach po lewej od tekstu */
	toc?: { id: string; label: string }[];
	content?: string | null;
	/* tło nagłówka — działa jak bg-main na stronie głównej (patrz SiteChrome) */
	heroBg?: import('../lib/heroBackground').HeroImage;
	heroAspect?: number;
}

const { heading, eyebrow, badge, lead, toc = [], content, heroBg, heroAspect } = Astro.props;
// spis ma sens dopiero przy kilku sekcjach
const showToc = toc.length >= 3;
---

<SiteChrome heroBg={heroBg} heroAspect={heroAspect}>
	<Section pb="calc(var(--space-content) * 2)" bgcolor="linear-gradient(to bottom, transparent 40%, var(--color-page))">
		<Container>
			<div class="prose-header stack">
				{(eyebrow || badge) && (
					<div class="post-meta">
						{eyebrow && <SectionBadge text={eyebrow} />}
						{badge && <p class="post-date">{badge}</p>}
					</div>
				)}
				<h1 set:html={accent(heading)} />
				{lead && <p class="post-lead">{lead}</p>}
			</div>
		</Container>
	</Section>

	<Section pt={0} bgcolor="var(--color-page)">
		<Container>
			<div class:list={['post-body', { 'has-toc': showToc }]}>
				<article class="prose">
					{content && <Fragment set:html={content} />}
				</article>
				{
					showToc && (
						<nav class="toc" aria-label="Spis treści">
							<p class="toc-title">Spis treści</p>
							<ol>
								{toc.map((item) => (
									<li>
										<a href={`#${item.id}`} set:html={item.label} />
									</li>
								))}
							</ol>
						</nav>
					)
				}
			</div>
		</Container>
	</Section>
</SiteChrome>

<script>
	// spis treści: podświetla sekcję, którą właśnie czytasz, i płynnie do niej przewija
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
	const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));

	if (links.length) {
		let last = -1;
		const update = () => {
			const line = window.innerHeight * 0.3;
			let current = -1;
			targets.forEach((target, i) => {
				if (target && target.getBoundingClientRect().top <= line) current = i;
			});
			links.forEach((link, i) => {
				if (i === current) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});

			// spis wyższy niż okno: aktywna pozycja zostaje widoczna
			const toc = links[0].closest<HTMLElement>('.toc');
			const active = links[current];
			if (toc && active && current !== last) {
				const top = active.offsetTop;
				const bottom = top + active.offsetHeight;
				if (top < toc.scrollTop) toc.scrollTop = top;
				else if (bottom > toc.scrollTop + toc.clientHeight) toc.scrollTop = bottom - toc.clientHeight;
			}
			last = current;
		};

		let queued = false;
		window.addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(() => {
					queued = false;
					update();
				});
			},
			{ passive: true },
		);
		update();

		const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		links.forEach((link, i) => {
			link.addEventListener('click', (event) => {
				event.preventDefault();
				targets[i]?.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto' });
				history.pushState(null, '', link.hash);
			});
		});
	}
</script>

<style>
	/* kolumna do czytania: ok. 70 znaków w wierszu, większa interlinia niż na
	   reszcie strony i jaśniejszy tekst — wpisy to długie teksty */
	/* wspólny rozmiar tekstu wpisu i spisu treści */
	.post-body {
		--prose-size: 18px;
	}

	.prose {
		width: 100%;
		max-width: 42rem;
		margin-inline: auto;
		--prose-line: 1.75;
		--prose-color: #e6f2fb;
	}

	.prose :global(:is(p, li, th, td)) {
		font-size: var(--prose-size);
		line-height: var(--prose-line);
		color: var(--prose-color);
	}

	.prose :global(strong) {
		color: var(--color-white);
	}

	.prose-header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
	}

	/* kategoria z lewej, data z prawej, w jednym wierszu nad tytułem */
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		width: 100%;
	}

	.post-meta + :global(h1) {
		margin-top: var(--space-eyebrow);
	}

	.post-lead {
		max-width: var(--measure);
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-energy);
	}

	.post-date {
		margin-left: auto;
		font-size: 1rem;
		white-space: nowrap;
		color: var(--color-font);
	}

	@media (max-width: 575px) {
		.prose {
			--prose-size: 17px;
			--prose-line: 1.7;
		}
	}

	/* *fragment* w nagłówku z CMS-u */
	.prose-header :global(.accent) {
		color: var(--color-energy);
	}

	/* wygląd etykiety z tokens.css (.eyebrow); tu tylko odstęp w treści z CMS-u */
	.prose :global(.eyebrow) {
		margin: 2rem 0 0.5rem;
	}

	.prose :global(h3) {
		margin: 2.5rem 0 0.75rem;
		font-size: clamp(1.2rem, 2vw, 1.4rem);
		line-height: 1.3;
	}

	@media (max-width: 575px) {
		.prose :global(.btn) {
			display: flex;
			width: 100%;
			max-width: var(--btn-mobile-width);
			margin: 0.5rem auto;
			font-size: 16px;
		}
	}

	.prose :global(.btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;
		padding: 0 2rem;
		border-radius: var(--radius-button);
		background: var(--gradient-button);
		color: var(--color-on-energy);
		font-weight: 600;
		text-decoration: none;
		box-shadow: var(--glow-energy);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.prose :global(.btn:hover) {
		transform: translateY(-2px);
		box-shadow: var(--glow-energy-hover);
	}

	.prose :global(.btn-outline) {
		background: transparent;
		border: var(--btn-outline-width) solid var(--btn-outline-color);
		color: var(--btn-outline-color);
		box-shadow: none;
	}

	.prose :global(.btn-outline:hover) {
		background: var(--btn-outline-color);
		color: var(--color-on-energy);
		box-shadow: var(--glow-energy);
	}

	.prose :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.5rem auto;
		border-radius: 0.75rem;
	}

	.prose :global(figure) {
		margin: 1.5rem 0;
	}

	.prose :global(figure img) {
		margin: 0;
	}

	.prose :global(figcaption) {
		margin-top: 0.5rem;
		color: var(--color-muted);
		font-size: 0.9rem;
		text-align: center;
	}

	.prose :global(blockquote) {
		margin: 0 0 1.25rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-energy);
		border-radius: 0.75rem;
	}

	.prose :global(blockquote footer) {
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.prose :global(h2) {
		margin-top: 4rem;
		margin-bottom: 1.25rem;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		line-height: 1.25;
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	/* kotwice ze spisu treści: nagłówek nie chowa się pod menu, także gdy pasek
	   kurczy się w trakcie przewijania od góry strony */
	.prose :global(h2) {
		scroll-margin-top: 9rem;
	}

	.toc {
		display: none;
	}

	/* szeroki ekran: spis treści przyklejony po lewej, tekst po prawej */
	@media (min-width: 1200px) {
		.has-toc {
			display: grid;
			/* tekst zajmuje całą resztę szerokości — stały odstęp od spisu */
			grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
			align-items: start;
			gap: 4rem;
		}

		.has-toc .prose {
			max-width: none;
			margin-inline: 0;
		}

		.toc {
			order: -1;
			position: sticky;
			top: 6rem;
			display: block;
			max-height: calc(100vh - 7rem);
			overflow-y: auto;
			scrollbar-width: thin;
			scrollbar-color: var(--color-border) transparent;
		}
	}

	/* --toc-indent: odstęp tekstu pozycji od lewej krawędzi spisu (linia + padding) */
	.toc {
		--toc-indent: 1.125rem;
	}

	.toc-title {
		margin-bottom: 1rem;
		padding-left: var(--toc-indent);
		font-size: var(--font-size-label);
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-energy);
	}

	.toc ol {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 1px solid var(--color-border);
	}

	.toc a {
		display: block;
		margin-left: -1px;
		padding: 0.4rem 0 0.4rem calc(var(--toc-indent) - 2px);
		font-size: var(--prose-size);
		line-height: 1.35;
		color: var(--color-muted);
		text-decoration: none;
		border-left: 2px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.toc a:hover {
		color: var(--color-white);
	}

	/* bez pogrubienia — zmieniałoby łamanie wierszy i lista by skakała */
	.toc a[aria-current] {
		color: var(--color-energy);
		border-left-color: var(--color-energy);
	}

	.prose :global(p) {
		margin-bottom: 1.25rem;
	}

	.prose :global(hr) {
		margin: 4rem 0;
		border: 0;
		border-top: 1px solid var(--color-border);
	}

	/* tabela z edytora: pełna szerokość tekstu, linie między wierszami */
	.prose :global(table) {
		width: 100%;
		margin: 0 0 1.5rem;
		border-collapse: collapse;
	}

	.prose :global(:is(th, td)) {
		padding: 0.75rem 1rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--color-border);
	}

	.prose :global(th) {
		font-weight: var(--font-weight-bold);
		--prose-color: var(--color-energy);
		border-bottom-color: var(--color-energy);
	}

	.prose :global(td:first-child) {
		font-weight: 600;
		white-space: nowrap;
	}

	@media (max-width: 575px) {
		.prose :global(:is(th, td)) {
			padding: 0.6rem 0.5rem;
		}
	}

	.prose :global(p.price) {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--color-energy);
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1.25rem;
	}

	/* znaczniki list w kolorze energy */
	.prose :global(li) {
		margin-bottom: 0.5rem;
	}

	.prose :global(li::marker) {
		color: var(--color-energy);
	}

	.prose :global(a) {
		color: var(--color-accent);
	}

	.prose :global(strong) {
		font-weight: var(--font-weight-bold);
	}

	.prose :global(details) {
		margin-bottom: 0.75rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		transition: border-color 0.15s ease;
	}

	.prose :global(details[open]) {
		border-color: var(--color-border-strong);
	}

	.prose :global(summary) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		font-weight: 600;
		list-style: none;
	}

	.prose :global(summary::-webkit-details-marker) {
		display: none;
	}

	.prose :global(summary::after) {
		content: '';
		flex-shrink: 0;
		width: 0.6rem;
		height: 0.6rem;
		border-right: 2px solid var(--color-accent);
		border-bottom: 2px solid var(--color-accent);
		transform: rotate(45deg);
		transition: transform 0.2s ease;
	}

	.prose :global(details[open] summary::after) {
		transform: rotate(-135deg);
	}

	.prose :global(details p) {
		margin-top: 0.75rem;
		margin-bottom: 0;
		color: var(--color-muted);
	}
</style>
