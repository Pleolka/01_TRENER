---
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import SectionBadge from './ui/SectionBadge.astro';

interface Props {
	heading: string;
	eyebrow?: string;
	badge?: string | null;
	content?: string | null;
}

const { heading, eyebrow, badge, content } = Astro.props;
---

<SiteChrome>
	<Section pt={5} pb={3}>
		<Container>
			<div class="prose-header">
				{eyebrow && <SectionBadge text={eyebrow} />}
				{badge && <span class="badge">{badge}</span>}
				<h1>{heading}</h1>
			</div>
		</Container>
	</Section>

	<Section pt={2} pb={6} bgcolor="var(--color-white)">
		<Container>
			<article class="prose">
				{content && <Fragment set:html={content} />}
			</article>
		</Container>
	</Section>
</SiteChrome>

<style>
	.prose {
		max-width: 42rem;
		margin-inline: auto;
	}

	.prose-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		text-align: center;
		max-width: 42rem;
		margin-inline: auto;
	}

	.badge {
		display: inline-block;
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.prose :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: var(--color-base);
	}

	.prose :global(p) {
		margin-bottom: 1rem;
	}

	.prose :global(p.price) {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--color-base);
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose :global(a) {
		color: var(--color-base);
	}

	.prose :global(strong) {
		font-weight: var(--font-weight-bold);
	}

	.prose :global(details) {
		margin-bottom: 0.75rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		transition: border-color 0.15s ease;
	}

	.prose :global(details[open]) {
		border-color: var(--color-border-strong);
	}

	.prose :global(summary) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		font-weight: 600;
		list-style: none;
	}

	.prose :global(summary::-webkit-details-marker) {
		display: none;
	}

	.prose :global(summary::after) {
		content: '';
		flex-shrink: 0;
		width: 0.6rem;
		height: 0.6rem;
		border-right: 2px solid var(--color-base);
		border-bottom: 2px solid var(--color-base);
		transform: rotate(45deg);
		transition: transform 0.2s ease;
	}

	.prose :global(details[open] summary::after) {
		transform: rotate(-135deg);
	}

	.prose :global(details p) {
		margin-top: 0.75rem;
		margin-bottom: 0;
		color: var(--color-muted);
	}
</style>
