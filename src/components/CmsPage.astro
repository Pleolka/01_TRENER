---
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import SectionBadge from './ui/SectionBadge.astro';

interface Props {
	heading: string;
	eyebrow?: string;
	badge?: string | null;
	content?: string | null;
}

const { heading, eyebrow, badge, content } = Astro.props;
---

<SiteChrome>
	<Section pt={5} pb={6}>
		<Container>
			<article class="prose">
				<div class="prose-header">
					{eyebrow && <SectionBadge text={eyebrow} />}
					{badge && <span class="badge">{badge}</span>}
					<h1>{heading}</h1>
				</div>
				{content && <Fragment set:html={content} />}
			</article>
		</Container>
	</Section>
</SiteChrome>

<style>
	.prose {
		max-width: 42rem;
		margin-inline: auto;
	}

	.prose-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		text-align: center;
		margin-bottom: 2rem;
	}

	.badge {
		display: inline-block;
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.prose :global(h1) {
		margin-bottom: 1.5rem;
	}

	.prose :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}

	.prose :global(p) {
		margin-bottom: 1rem;
	}

	.prose :global(p.price) {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--color-base);
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose :global(a) {
		color: var(--color-base);
	}

	.prose :global(strong) {
		font-weight: var(--font-weight-bold);
	}

	.prose :global(details) {
		margin-bottom: 0.75rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
	}

	.prose :global(details[open]) {
		border-color: var(--color-border-strong);
	}

	.prose :global(summary) {
		cursor: pointer;
		font-weight: 600;
	}

	.prose :global(details p) {
		margin-top: 0.75rem;
		margin-bottom: 0;
		color: var(--color-muted);
	}
</style>
