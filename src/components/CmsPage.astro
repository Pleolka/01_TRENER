---
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import SectionBadge from './ui/SectionBadge.astro';
import { accent } from '../lib/accent';

// Strona z nagłówkiem i treścią HTML — używana przez wpisy bloga.
interface Props {
	heading: string;
	eyebrow?: string;
	badge?: string | null;
	content?: string | null;
	/* tło nagłówka — działa jak bg-main na stronie głównej (patrz SiteChrome) */
	heroBg?: import('../lib/heroBackground').HeroImage;
	heroAspect?: number;
}

const { heading, eyebrow, badge, content, heroBg, heroAspect } = Astro.props;
---

<SiteChrome heroBg={heroBg} heroAspect={heroAspect}>
	<Section pb={0}>
		<Container>
			<div class="prose-header stack">
				{eyebrow && <SectionBadge text={eyebrow} />}
				{badge && <p class="eyebrow">{badge}</p>}
				<h1 set:html={accent(heading)} />
			</div>
		</Container>
	</Section>

	<Section pt="var(--space-content)" bgcolor="var(--color-bg)">
		<Container>
			<article class="prose">
				{content && <Fragment set:html={content} />}
			</article>
		</Container>
	</Section>
</SiteChrome>

<style>
	/* bloki na pełną szerokość kontenera, linie tekstu do --measure */
	.prose :global(:is(p, ul, ol, blockquote, details, h2, h3)) {
		max-width: var(--measure);
	}

	.prose-header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
	}

	/* *fragment* w nagłówku z CMS-u */
	.prose-header :global(.accent) {
		color: var(--color-energy);
	}

	/* wygląd etykiety z tokens.css (.eyebrow); tu tylko odstęp w treści z CMS-u */
	.prose :global(.eyebrow) {
		margin: 2rem 0 0.5rem;
	}

	.prose :global(h3) {
		margin: 1.5rem 0 0.5rem;
	}

	@media (max-width: 575px) {
		.prose :global(.btn) {
			display: flex;
			width: 100%;
			max-width: var(--btn-mobile-width);
			margin: 0.5rem auto;
			font-size: 16px;
		}
	}

	.prose :global(.btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;
		padding: 0 2rem;
		border-radius: var(--radius-button);
		background: var(--gradient-button);
		color: var(--color-on-energy);
		font-weight: 600;
		text-decoration: none;
		box-shadow: var(--glow-energy);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.prose :global(.btn:hover) {
		transform: translateY(-2px);
		box-shadow: var(--glow-energy-hover);
	}

	.prose :global(.btn-outline) {
		background: transparent;
		border: var(--btn-outline-width) solid var(--btn-outline-color);
		color: var(--btn-outline-color);
		box-shadow: none;
	}

	.prose :global(.btn-outline:hover) {
		background: var(--btn-outline-color);
		color: var(--color-on-energy);
		box-shadow: var(--glow-energy);
	}

	.prose :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.5rem auto;
		border-radius: 0.75rem;
	}

	.prose :global(figure) {
		margin: 1.5rem 0;
	}

	.prose :global(figure img) {
		margin: 0;
	}

	.prose :global(figcaption) {
		margin-top: 0.5rem;
		color: var(--color-muted);
		font-size: 0.9rem;
		text-align: center;
	}

	.prose :global(blockquote) {
		margin: 0 0 1.25rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-energy);
		border-radius: 0.75rem;
	}

	.prose :global(blockquote footer) {
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.prose :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}

	.prose :global(p) {
		margin-bottom: 1rem;
	}

	.prose :global(p.price) {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--color-energy);
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose :global(a) {
		color: var(--color-accent);
	}

	.prose :global(strong) {
		font-weight: var(--font-weight-bold);
	}

	.prose :global(details) {
		margin-bottom: 0.75rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		transition: border-color 0.15s ease;
	}

	.prose :global(details[open]) {
		border-color: var(--color-border-strong);
	}

	.prose :global(summary) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		font-weight: 600;
		list-style: none;
	}

	.prose :global(summary::-webkit-details-marker) {
		display: none;
	}

	.prose :global(summary::after) {
		content: '';
		flex-shrink: 0;
		width: 0.6rem;
		height: 0.6rem;
		border-right: 2px solid var(--color-accent);
		border-bottom: 2px solid var(--color-accent);
		transform: rotate(45deg);
		transition: transform 0.2s ease;
	}

	.prose :global(details[open] summary::after) {
		transform: rotate(-135deg);
	}

	.prose :global(details p) {
		margin-top: 0.75rem;
		margin-bottom: 0;
		color: var(--color-muted);
	}
</style>
