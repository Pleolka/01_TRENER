---
import Footer from './Footer.astro';
import Navbar from './Navbar.astro';
---

<div class="page">
	<div class="banner" aria-hidden="true"></div>

	<Navbar />

	<main class="main">
		<slot />
	</main>

	<Footer />
</div>

<style>
	.page {
		position: relative;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.banner {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 600px;
		background: var(--gradient-banner);
		z-index: -1;
	}

	.main {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
</style>
