---
import Footer from './Footer.astro';
import Navbar from './Navbar.astro';
import type { HeroImage } from '../lib/heroBackground';

interface Props {
	heroBg?: HeroImage;
	/* proporcje zdjęcia tła (szerokość / wysokość) — tło ma wysokość całego zdjęcia */
	heroAspect?: number;
}

const { heroBg, heroAspect = 16 / 9 } = Astro.props;
---

<div class="page">
	{
		heroBg && (
			<div class="hero-bg" style={`--hero-aspect:${heroAspect}`} aria-hidden="true">
				{/* element LCP — od razu w HTML, z wysokim priorytetem pobierania */}
				<img
					class="hero-bg-img"
					src={heroBg.src}
					srcset={heroBg.srcset}
					sizes="100vw"
					alt=""
					fetchpriority="high"
					decoding="async"
					style={`object-position:${heroBg.position}`}
				/>
			</div>
		)
	}

	<Navbar />

	<slot name="hero" />

	<main class="main">
		<slot />
	</main>

	<Footer />
</div>

<style>
	.page {
		position: relative;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		/* pełna wysokość zdjęcia przy szerokości ekranu; na wąskich ekranach
		   min. 820px, żeby tło sięgało pod całe hero */
		aspect-ratio: var(--hero-aspect);
		min-height: 820px;
		z-index: -1;
		opacity: 0.4;
		/* tło zaczyna wygasać od ~1/3 wysokości i znika dopiero na samym dole zdjęcia */
		mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
		-webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
		/* warstwa koloru mieszana tylko ze zdjęciem, nie z tłem strony */
		isolation: isolate;
	}

	/* filtr na osobnej warstwie — inaczej odbarwiłby też nakładkę koloru */
	.hero-bg-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: var(--filter-photo);
	}

	.hero-bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--tint-photo);
		mix-blend-mode: color;
	}

	.main {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
</style>
