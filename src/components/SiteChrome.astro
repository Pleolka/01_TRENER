---
import { list as navItems } from '../assets/data/strukturaStrony';
import logo from '../images/logo.svg';

const footerLinks = [
	{ name: 'Regulamin', path: '/regulamin' },
	{ name: 'Polityka prywatności', path: '/polityka-prywatnosci' },
];

const year = new Date().getFullYear();
---

<div class="page">
	<div class="navbar">
		<header class="pill">
			<a class="logo" href="/">
				<img src={logo.src} alt="Trener Shop" />
			</a>

			<input type="checkbox" id="nav-toggle" class="nav-toggle" />
			<label for="nav-toggle" class="nav-toggle-label" aria-label="Otwórz menu">
				<span></span>
			</label>

			<nav class="nav">
				{navItems.map((item) => <a href={item.path}>{item.name}</a>)}
			</nav>
		</header>
	</div>

	<main class="main">
		<slot />
	</main>

	<footer class="footer">
		<span>&copy; {year} Trener Shop</span>
		<div class="footer-links">
			{footerLinks.map((item) => <a href={item.path}>{item.name}</a>)}
		</div>
	</footer>
</div>

<style>
	.page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		font-family: system-ui, sans-serif;
		color: #1a1a1a;
	}

	.navbar {
		position: sticky;
		top: 1rem;
		z-index: 50;
		display: flex;
		justify-content: center;
		margin-top: 1rem;
		padding: 0 1rem;
	}

	.pill {
		position: relative;
		display: flex;
		align-items: center;
		gap: 2rem;
		width: fit-content;
		max-width: 100%;
		padding: 0.65rem 1.5rem;
		background: #fff;
		border: 1px solid #eee;
		border-radius: 999px;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
	}

	.logo {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.logo img {
		height: 1.5rem;
		width: auto;
		display: block;
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.nav a {
		color: #444;
		text-decoration: none;
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.nav a:hover {
		color: #000;
	}

	.nav-toggle {
		display: none;
	}

	.nav-toggle-label {
		display: none;
		flex-shrink: 0;
		width: 1.5rem;
		height: 1.5rem;
		cursor: pointer;
		align-items: center;
		justify-content: center;
	}

	.nav-toggle-label span,
	.nav-toggle-label span::before,
	.nav-toggle-label span::after {
		display: block;
		width: 1.25rem;
		height: 2px;
		background: #1a1a1a;
		border-radius: 2px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.nav-toggle-label span {
		position: relative;
	}

	.nav-toggle-label span::before,
	.nav-toggle-label span::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.nav-toggle-label span::before {
		top: -6px;
	}

	.nav-toggle-label span::after {
		top: 6px;
	}

	.nav-toggle:checked ~ .nav-toggle-label span {
		background: transparent;
	}

	.nav-toggle:checked ~ .nav-toggle-label span::before {
		top: 0;
		transform: rotate(45deg);
	}

	.nav-toggle:checked ~ .nav-toggle-label span::after {
		top: 0;
		transform: rotate(-45deg);
	}

	@media (max-width: 640px) {
		.pill {
			width: 100%;
			justify-content: space-between;
		}

		.nav-toggle-label {
			display: flex;
		}

		.nav {
			display: none;
			position: absolute;
			top: calc(100% + 0.75rem);
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: center;
			gap: 1rem;
			padding: 1.25rem;
			background: #fff;
			border: 1px solid #eee;
			border-radius: 1.5rem;
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
		}

		.nav-toggle:checked ~ .nav {
			display: flex;
		}
	}

	.main {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.footer {
		padding: 1.5rem;
		text-align: center;
		color: #888;
		font-size: 0.85rem;
		border-top: 1px solid #eee;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.footer-links {
		display: flex;
		gap: 1rem;
	}

	.footer-links a {
		color: #888;
		text-decoration: none;
	}

	.footer-links a:hover {
		color: #444;
	}
</style>
