---
import { list as navItems } from "../assets/data/strukturaStrony";
import logo from "../images/logo.svg";
import Footer from "./Footer.astro";

const links = navItems.filter((item) => !item.cta);
const cta = navItems.find((item) => item.cta);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="page">
  <div class="banner" aria-hidden="true"></div>

  <div class="navbar">
    <header class="pill">
      <a class="logo" href="/">
        <img src={logo.src} alt="Trener Shop" />
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Otwórz menu">
        <span></span>
      </label>

      <nav class="nav">
        {
          links.map((item) => (
            <a
              href={item.path}
              class:list={["nav-link", { active: item.path === currentPath }]}
            >
              {item.name}
            </a>
          ))
        }
      </nav>

      {
        cta && (
          <a class="nav-cta" href={cta.path}>
            {cta.name}
          </a>
        )
      }
    </header>
  </div>

  <main class="main">
    <slot />
  </main>

  <Footer />
</div>

<style>
  .page {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 600px;
    background: var(--gradient-banner);
    z-index: -1;
  }

  .navbar {
    position: sticky;
    top: 1rem;
    z-index: 50;
    display: flex;
    justify-content: center;
    margin-top: 1rem;
    padding: 0 1rem;
  }

  .pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 900px;
    padding: 0.5rem 0.5rem 0.5rem 1.5rem;
    background: var(--color-white);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo img {
    height: 1.5rem;
    width: auto;
    display: block;
  }

  .nav {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--color-nav);
    text-decoration: none;
    font-size: var(--font-size-p);
    font-weight: 600;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-base);
  }

  .nav-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.5rem;
    border-radius: 999px;
    background: var(--gradient-button);
    color: var(--color-white);
    font-size: var(--font-size-p);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.2s ease;
  }

  .nav-cta:hover {
    filter: brightness(0.9);
  }

  .nav-toggle {
    display: none;
  }

  .nav-toggle-label {
    display: none;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .nav-toggle-label span,
  .nav-toggle-label span::before,
  .nav-toggle-label span::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--color-font);
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .nav-toggle-label span {
    position: relative;
  }

  .nav-toggle-label span::before,
  .nav-toggle-label span::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .nav-toggle-label span::before {
    top: -6px;
  }

  .nav-toggle-label span::after {
    top: 6px;
  }

  .nav-toggle:checked ~ .nav-toggle-label span {
    background: transparent;
  }

  .nav-toggle:checked ~ .nav-toggle-label span::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle:checked ~ .nav-toggle-label span::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 640px) {
    .nav-toggle-label {
      display: flex;
      margin-left: auto;
    }

    .nav {
      display: none;
      position: absolute;
      top: calc(100% + 0.75rem);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: 1.5rem;
    }

    .nav-toggle:checked ~ .nav {
      display: flex;
    }
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
