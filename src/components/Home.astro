---
import { Image } from 'astro:assets';
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import SectionBadge from './ui/SectionBadge.astro';
import trener from '../images/trener.png';
import { heroBackground } from '../lib/heroBackground';
import bgImage from '../images/bg-ciezary-2.jpg';

const hero = await heroBackground(bgImage, 'center');

import type { HomeContent, CmsImage } from '../lib/datocms';
import { accent } from '../lib/accent';

interface Props {
	content: HomeContent;
	/* zdjęcie z pola „Zdjęcie w hero” w DatoCMS; bez niego — trener.png */
	heroImage?: CmsImage | null;
}

const { content, heroImage } = Astro.props;

const lines = (text: string) => text.split('\n').map((l) => l.trim()).filter(Boolean);
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const parts = (line: string) => line.split('|').map((p) => p.trim());

const heroStats = lines(content.heroStats).map((l) => {
	const [value, suffix, label] = l.split('|').map((p) => p.trim());
	return { value, suffix, label };
});
const coachingStats = lines(content.coachingStats).map((l) => {
	const [value, suffix, label] = l.split('|').map((p) => p.trim());
	return { value, suffix, label };
});
const pillars = lines(content.pillars).map((l) => {
	const [title, description] = parts(l);
	return { title, description };
});
---

<SiteChrome {...hero}>
	<Section slot="hero" pt={6} pb={0}>
		<Container mb="0">
			<div class="hero">
				<div class="hero-content">
					<SectionBadge text={content.heroBadge} />
					<h1 set:html={accent(content.heroHeading)} />
					<p class="subtitle">{content.heroText}</p>
					<div class="hero-actions">
						<Button href="#cooperation">{content.heroPrimaryButton}</Button>
						<Button href="/sklep-online" variant="outline">{content.heroSecondaryButton}</Button>
					</div>
					<div class="stats">
						{
							heroStats.map((stat) => (
								<div class="stat">
									<span class="stat-value">
										{stat.value}
										{stat.suffix}
									</span>
									<span class="stat-label">{stat.label}</span>
								</div>
							))
						}
					</div>
				</div>
				<figure class="hero-image">
					{
						heroImage ? (
							<img
								src={`${heroImage.url}?w=900&auto=format&q=85`}
								srcset={`${heroImage.url}?w=500&auto=format&q=85 500w, ${heroImage.url}?w=900&auto=format&q=85 900w, ${heroImage.url}?w=1300&auto=format&q=85 1300w`}
								sizes="(max-width: 900px) 90vw, 50vw"
								alt={heroImage.alt ?? ''}
								width={heroImage.width}
								height={heroImage.height}
								loading="eager"
							/>
						) : (
							<Image src={trener} alt="Natalia Figas — trenerka personalna" widths={[400, 624, 749]} sizes="(max-width: 900px) 90vw, 50vw" loading="eager" />
						)
					}
				</figure>
			</div>
		</Container>
	</Section>

	<Section pt={4} pb={5} bgcolor="var(--color-section-alt)">
		<Container>
			<div class="section-header">
				<SectionBadge text={content.aboutBadge} />
				<h2 set:html={accent(content.aboutHeading)} />
				{paragraphs(content.aboutText).map((p) => <p>{p}</p>)}
			</div>
			<div class="teasers">
				{
					pillars.map((pillar) => (
						<div class="teaser">
							<h3>{pillar.title}</h3>
							<p class="teaser-description">{pillar.description}</p>
						</div>
					))
				}
			</div>
			<div class="section-cta">
				<Button href="/o-mnie">{content.aboutButton}</Button>
			</div>
		</Container>
	</Section>

	<Section pt={3} pb={5} bgcolor="var(--color-bg)">
		<Container>
			<div class="feature" id="cooperation">
				<SectionBadge text={content.coachingBadge} />
				<h2 set:html={accent(content.coachingHeading)} />
				<p>{content.coachingText}</p>
				<ul class="feature-list">
					{lines(content.coachingList).map((item) => <li>{item}</li>)}
				</ul>
				<Button href="#apply">{content.coachingButton}</Button>
				<div class="stats">
					{
						coachingStats.map((stat) => (
							<div class="stat">
								<span class="stat-value">
									{stat.value}
									{stat.suffix}
								</span>
								<span class="stat-label">{stat.label}</span>
							</div>
						))
					}
				</div>
			</div>
		</Container>
	</Section>

	<Section pt={3} pb={5} bgcolor="var(--color-section-alt)">
		<Container>
			<div class="feature" id="products">
				<SectionBadge text={content.dietBadge} />
				<h2 set:html={accent(content.dietHeading)} />
				<p>{content.dietText}</p>
				<ul class="feature-list">
					{lines(content.dietList).map((item) => <li>{item}</li>)}
				</ul>
				<div class="hero-actions">
					<Button href="#subscribe">{content.dietPrimaryButton}</Button>
					<Button href="#recipes" variant="outline">{content.dietSecondaryButton}</Button>
				</div>
			</div>
		</Container>
	</Section>

	<Section pt={3} pb={6} bgcolor="var(--color-bg)">
		<Container>
			<div class="lead-teaser" id="newsletter">
				<SectionBadge text={content.newsletterBadge} />
				<h2 set:html={accent(content.newsletterHeading)} />
				<p>{content.newsletterText}</p>
				<ul class="feature-list">
					{lines(content.newsletterList).map((item) => <li>{item}</li>)}
				</ul>
				{/* zapis przez Netlify Forms — zgłoszenia w panelu Netlify (Forms → newsletter) */}
				<form
					class="newsletter-form"
					name="newsletter"
					method="POST"
					data-netlify="true"
					netlify-honeypot="bot-field"
					action="/dziekujemy"
				>
					<input type="hidden" name="form-name" value="newsletter" />
					<p class="honeypot">
						<label>
							Nie wypełniaj tego pola
							<input name="bot-field" />
						</label>
					</p>
					<label class="visually-hidden" for="newsletter-email">E-mail</label>
					<input
						type="email"
						id="newsletter-email"
						name="email"
						autocomplete="email"
						placeholder={content.newsletterPlaceholder}
						required
					/>
					<button type="submit">{content.newsletterButton}</button>
				</form>
			</div>
		</Container>
	</Section>
</SiteChrome>

<style>
	/* układ jak sekcje na O mnie (ImageSections): pół na pół,
	   zdjęcie stoi na dolnej krawędzi sekcji */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
		gap: clamp(2rem, 6vw, 6rem);
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
		gap: 1.25rem;
		/* tekst wyśrodkowany w pionie, z odstępem od dołu sekcji */
		align-self: center;
		padding-bottom: 5rem;
	}

	.hero h1 {
		max-width: 30rem;
	}

	.accent {
		color: var(--color-energy);
	}

	.subtitle {
		color: var(--color-muted);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 1rem;
		margin-top: 0.5rem;
	}

	.hero-image {
		margin: 0;
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		margin-top: 0.5rem;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.stat-value {
		font-family: var(--font-family-heading);
		font-weight: var(--font-weight-h);
		font-size: 2.25rem;
		line-height: 1.1;
		color: var(--color-energy);
		background: var(--gradient-energy);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.stat-label {
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			text-align: center;
		}

		.hero-content {
			align-items: center;
			text-align: center;
			padding-bottom: 2.5rem;
		}

		/* zdjęcie pod tekstem, na dole sekcji */
		.hero-image {
			max-width: 26rem;
			width: 100%;
			margin-inline: auto;
		}

		.hero-actions,
		.stats {
			justify-content: center;
		}
	}

	.section-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.section-header p {
		max-width: var(--measure);
		color: var(--color-muted);
	}

	.section-cta {
		display: flex;
		justify-content: center;
		margin-top: 2rem;
	}

	.teasers {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
		gap: 1.5rem;
	}

	.teaser {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 1.75rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 1rem;
	}

	.teaser h3 {
		font-size: 1.2rem;
	}

	.teaser-description {
		color: var(--color-muted);
		flex: 1;
	}

	.section-header h2,
	.feature h2,
	.lead-teaser h2 {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
	}

	.feature {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		text-align: center;
	}

	.feature p {
		max-width: var(--measure);
		color: var(--color-muted);
	}

	.feature-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem 1.5rem;
		font-weight: 600;
	}

	.feature .stats {
		justify-content: center;
	}

	.lead-teaser {
		position: relative;
		overflow: hidden;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	/* pole e-mail + przycisk w jednym rzędzie, na wąskich ekranach jedno pod drugim */
	.newsletter-form {
		display: flex;
		gap: 0.75rem;
		width: 100%;
		max-width: 32rem;
		margin-top: 1rem;
	}

	.newsletter-form input[type='email'] {
		flex: 1;
		min-width: 0;
		padding: 0.75rem 1rem;
		font: inherit;
		color: var(--color-font);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-button);
	}

	.newsletter-form input[type='email']::placeholder {
		color: var(--color-muted);
	}

	.newsletter-form input[type='email']:focus {
		outline: none;
		border-color: var(--color-energy);
	}

	.newsletter-form button {
		flex-shrink: 0;
		padding: 0 2rem;
		min-height: 48px;
		font: inherit;
		font-weight: 600;
		color: var(--color-on-energy);
		background: var(--gradient-button);
		border: none;
		border-radius: var(--radius-button);
		box-shadow: var(--glow-energy);
		cursor: pointer;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.newsletter-form button:hover {
		transform: translateY(-2px);
		box-shadow: var(--glow-energy-hover);
	}

	.honeypot {
		position: absolute;
		left: -9999px;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	@media (max-width: 575px) {
		.newsletter-form {
			flex-direction: column;
		}
	}

	.lead-teaser p {
		max-width: var(--measure);
		color: var(--color-muted);
	}

	.lead-teaser .feature-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-weight: 600;
	}
</style>
