---
import SiteChrome from './SiteChrome.astro';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import SectionBadge from './ui/SectionBadge.astro';

const teasers = [
	{
		title: 'Konsultacje z trenerem personalnym',
		tagline: 'Pozbądź się wątpliwości na treningu podczas jednej rozmowy!',
		description:
			'Stop niepewności na treningu! Ustal raz na zawsze jak zrobić rozgrzewkę, dobierać ciężar do ćwiczeń, albo ustawić się do przysiadów bułgarskich.',
		path: '/konsultacje-z-trenerem-personalnym',
		icon: 'chat',
	},
	{
		title: 'Współpraca treningowa online',
		tagline: 'Zbuduj zdrowe i silne ciało',
		description:
			'Tworzę dla Ciebie system, który uwzględnia Twoje preferencje, umiejętności i aktualne możliwości oraz prowadzę Cię prosto do efektów.',
		path: '/online-coaching',
		icon: 'monitor',
	},
	{
		title: 'Mocny brzuch w 6 tygodni',
		tagline: 'Zbuduj silne mięśnie brzucha w zaledwie 1,5 miesiąca',
		description:
			'Zamiast wykonywać co trening różne ćwiczenia, które dają niewielkie rezultaty, ja stworzyłam system najskuteczniejszych ćwiczeń — z nim Twój brzuch będzie silny i wyrzeźbiony.',
		path: '/mocny-brzuch-w-6-tygodni',
		icon: 'target',
	},
];

const ICONS = {
	chat: 'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z|m9 12 2 2 4-4',
	monitor: 'M2 3h20a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z|M8 21h8|M12 17v4',
	target: 'M12 12m-10 0a10 10 0 1 0 20 0a10 10 0 1 0 -20 0|M12 12m-6 0a6 6 0 1 0 12 0a6 6 0 1 0 -12 0|M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0',
};

const miniProducts = [
	{
		title: 'Spontaniczny ruch',
		description:
			'Sprawdzone sposoby na więcej spontanicznego ruchu (NEAT) — nawet, jeśli prowadzisz „życie na siedząco”.',
		price: '59 PLN',
	},
	{
		title: 'Regeneracja ciała',
		description: 'Metody regeneracji ciała i układu nerwowego po aktywności fizycznej: techniki, schematy, suplementy.',
		price: '99 PLN',
	},
	{
		title: 'Dyscyplina na co dzień',
		description: 'System ułatwiający stworzenie i utrzymanie nawyków wspierających Twoje zdrowie.',
		price: '199 PLN',
	},
];
---

<SiteChrome>
	<Section pt={6} pb={5}>
		<Container>
			<div class="hero">
				<SectionBadge text="Trening dopasowany do Ciebie" />
				<h1><span class="accent">Zmień</span> swoje ciało ze mną!</h1>
				<p class="subtitle">
					Pomagam ułożyć trening i nawyki tak, by pasowały do Twojego życia — bez chaosu,
					zgadywania i przypadkowych planów.
				</p>
				<div class="hero-actions">
					<Button href="/konsultacje-z-trenerem-personalnym">Umów konsultację</Button>
					<Button href="/sklep" variant="outline">Zobacz ofertę</Button>
				</div>
			</div>
			<img class="watermark watermark--hero" src="/favicon.svg" alt="" aria-hidden="true" />
		</Container>
	</Section>

	<Section pt={4} pb={5} bgcolor="var(--color-white)">
		<Container>
			<div class="section-header">
				<SectionBadge text="Twoja droga do lepszego samopoczucia" />
				<h2>Wszystko, czego potrzebujesz, by <span class="accent">poczuć się najlepiej</span></h2>
			</div>
			<div class="teasers">
				{
					teasers.map((teaser) => (
						<a class="teaser" href={teaser.path}>
							<span class="teaser-icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									{ICONS[teaser.icon as keyof typeof ICONS].split('|').map((d: string) => (
										<path d={d} />
									))}
								</svg>
							</span>
							<h3>{teaser.title}</h3>
							<p class="teaser-tagline">{teaser.tagline}</p>
							<p class="teaser-description">{teaser.description}</p>
							<span class="teaser-link">Dowiedz się więcej →</span>
						</a>
					))
				}
			</div>
		</Container>
	</Section>

	<Section pt={3} pb={5} bgcolor="var(--color-white)">
		<Container>
			<div class="section-header">
				<SectionBadge text="Sklep" />
				<h2>Tworzę praktyczne i <span class="accent">łatwe procedury</span>, które wspomagają zdrowie</h2>
			</div>
			<div class="products-grid">
				{
					miniProducts.map((product) => (
						<div class="product-card">
							<h3>{product.title}</h3>
							<p>{product.description}</p>
							<span class="price">{product.price}</span>
						</div>
					))
				}
			</div>
		</Container>
	</Section>

	<Section pt={3} pb={6} bgcolor="var(--color-white)">
		<Container>
			<div class="lead-teaser">
				<img class="watermark watermark--lead" src="/favicon.svg" alt="" aria-hidden="true" />
				<SectionBadge text="Sprawdź za darmo, jak się ze mną pracuje" />
				<h2>Pobierz e-booka <span class="accent">„Lekka redukcja”</span></h2>
				<p>
					Pobierz darmowego e-booka z 3-dniowym jadłospisem na super łatwą redukcję bez
					wyrzeczeń. Sprawdź na własnej skórze efekty współpracy ze mną! 🥑🥗
				</p>
				<Button href="/lekka-redukcja">Pobierz e-booka</Button>
			</div>
		</Container>
	</Section>
</SiteChrome>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.25rem;
		max-width: 40rem;
		margin-inline: auto;
	}

	.hero h1 {
		max-width: 30rem;
	}

	.accent {
		color: var(--color-base);
	}

	.subtitle {
		color: var(--color-muted);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 0.5rem;
	}

	.watermark {
		position: absolute;
		width: 14rem;
		height: 14rem;
		opacity: 0.08;
		pointer-events: none;
		z-index: -1;
	}

	.watermark--hero {
		top: -2rem;
		right: 0;
	}

	.watermark--lead {
		bottom: -2rem;
		left: -2rem;
		width: 10rem;
		height: 10rem;
	}

	.section-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		max-width: 40rem;
		margin: 0 auto 2.5rem;
	}

	.teasers {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.5rem;
	}

	.teaser {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 1.75rem;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.teaser:hover {
		border-color: var(--color-border-strong);
		transform: translateY(-2px);
	}

	.teaser-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.75rem;
		background: var(--color-surface);
		color: var(--color-base);
	}

	.teaser-icon svg {
		width: 1.4rem;
		height: 1.4rem;
	}

	.teaser h3 {
		font-size: 1.2rem;
	}

	.teaser-tagline {
		font-style: italic;
		color: var(--color-base);
		font-weight: 600;
	}

	.teaser-description {
		color: var(--color-muted);
		flex: 1;
	}

	.teaser-link {
		font-weight: 600;
		color: var(--color-base);
	}

	.section-header h2,
	.lead-teaser h2 {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1.25rem;
	}

	.product-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
	}

	.product-card h3 {
		font-size: 1.1rem;
	}

	.product-card p {
		color: var(--color-muted);
		font-size: 0.9rem;
		flex: 1;
	}

	.product-card .price {
		font-weight: 700;
		color: var(--color-base);
	}

	.lead-teaser {
		position: relative;
		overflow: hidden;
		max-width: 40rem;
		margin-inline: auto;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		padding: 2.5rem;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 1.5rem;
	}

	.lead-teaser p {
		color: var(--color-muted);
	}
</style>
