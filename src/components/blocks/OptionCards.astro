---
// Warianty z przyciskiem (np. długość subskrypcji).
// Opcjonalne zdjęcie z CMS-u na górze karty — z łagodnym filtrem marki.
import Button from '../ui/Button.astro';
import type { CmsOptionItem } from '../../lib/datocms';

interface Props {
	options: CmsOptionItem[];
}

const { options } = Astro.props;
---

<div class="options">
	{
		options.map((option) => (
			<article class:list={['option', { 'has-image': option.image }]}>
				{option.image && (
					<span class="photo-wrap">
						<img
							class="photo"
							src={`${option.image.url}?w=640&h=400&fit=crop&auto=format&q=80`}
							srcset={`${option.image.url}?w=400&h=250&fit=crop&auto=format&q=80 400w, ${option.image.url}?w=640&h=400&fit=crop&auto=format&q=80 640w, ${option.image.url}?w=960&h=600&fit=crop&auto=format&q=80 960w`}
							sizes="(max-width: 900px) 90vw, 33vw"
							alt={option.image.alt ?? ''}
							width="640"
							height="400"
							loading="lazy"
						/>
					</span>
				)}
				<h3>{option.title}</h3>
				{option.description && <p>{option.description}</p>}
				{option.buttonLabel && option.buttonUrl && (
					<div class="action">
						<Button href={option.buttonUrl} variant="outline">
							{option.buttonLabel}
						</Button>
					</div>
				)}
			</article>
		))
	}
</div>

<style>
	.options {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
		gap: 1.5rem;
	}

	.option {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-button);
	}

	/* zdjęcie na górze karty, od krawędzi do krawędzi; łagodny filtr marki —
	   ten sam co karty kroków, pakietów i opinii (tokens.css: --filter-photo-soft) */
	.has-image {
		overflow: hidden;
		border-top: 2px solid var(--color-energy);
	}

	.photo-wrap {
		position: relative;
		display: block;
		margin: -2rem -2rem 0.5rem;
		isolation: isolate;
	}

	.photo-wrap::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--tint-photo);
		mix-blend-mode: color;
		opacity: var(--tint-photo-soft-opacity);
		pointer-events: none;
	}

	.photo {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		filter: var(--filter-photo-soft);
	}

	h3 {
		font-size: 1.4rem;
	}

	p {
		color: var(--color-muted);
	}

	.action {
		margin-top: auto;
		padding-top: 1rem;
	}
</style>
