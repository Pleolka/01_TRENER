---
// Siatka pozycji „tytuł + opis” (zakres współpracy, korzyści, kroki).
// numbered — automatyczna numeracja 01, 02, 03…
import type { CmsFeatureItem } from '../../lib/datocms';

interface Props {
	items: CmsFeatureItem[];
	numbered?: boolean;
}

const { items, numbered = false } = Astro.props;
---

<ul class="feature-grid">
	{
		items.map((item, i) => (
			<li class="feature">
				{numbered && <span class="number">{String(i + 1).padStart(2, '0')}</span>}
				<h3>{item.title}</h3>
				{item.description && <p>{item.description}</p>}
			</li>
		))
	}
</ul>

<style>
	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.feature {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.75rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-top: 2px solid var(--color-energy);
		border-radius: var(--radius-button);
	}

	.number {
		font-family: var(--font-family-heading);
		font-size: 1.75rem;
		line-height: 1;
		color: var(--color-energy);
	}

	h3 {
		font-size: 1.25rem;
	}

	p {
		color: var(--color-muted);
		font-size: 0.95rem;
	}
</style>
