---
// Hero podstrony: etykieta, nazwa programu, H1, tekst, dwa przyciski.
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { accent } from '../../lib/accent';
import type { CmsHero } from '../../lib/datocms';

interface Props {
	hero: CmsHero;
}

const { hero } = Astro.props;
---

<Section>
	<Container mt="0" mb="0">
		<div class="page-hero stack">
			{hero.heroBadge && <p class="eyebrow">{hero.heroBadge}</p>}
			{hero.heroLabel && <p class="label">{hero.heroLabel}</p>}
			<h1 set:html={accent(hero.heroHeading)} />
			{hero.heroText && <div class="text" set:html={hero.heroText} />}
			{
				(hero.heroPrimaryLabel || hero.heroSecondaryLabel) && (
					<div class="actions stack-gap">
						{hero.heroPrimaryLabel && hero.heroPrimaryUrl && <Button href={hero.heroPrimaryUrl}>{hero.heroPrimaryLabel}</Button>}
						{hero.heroSecondaryLabel && hero.heroSecondaryUrl && (
							<Button href={hero.heroSecondaryUrl} variant="outline">
								{hero.heroSecondaryLabel}
							</Button>
						)}
					</div>
				)
			}
		</div>
	</Container>
</Section>

<style>
	.page-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	/* nazwa programu (np. 2halves) — duża, w kroju nagłówków */
	.label {
		font-family: var(--font-family-heading);
		font-size: var(--font-size-h3);
		font-style: italic;
		color: var(--color-energy);
	}

	h1 {
		max-width: 20ch;
	}

	h1 :global(.accent) {
		color: var(--color-energy);
	}

	.text {
		max-width: var(--measure);
	}

	.text :global(p) {
		color: var(--color-font);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
</style>
