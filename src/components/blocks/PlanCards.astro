---
// Pakiety cenowe (np. diety w subskrypcji).
import Button from '../ui/Button.astro';
import type { CmsPlan } from '../../lib/datocms';

interface Props {
	plans: CmsPlan[];
}

const { plans } = Astro.props;
const lines = (text: string | null) => (text ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
---

<div class="plans">
	{
		plans.map((plan) => (
			<article class="plan">
				<h3>{plan.name}</h3>
				{plan.description && <p class="description">{plan.description}</p>}
				{lines(plan.features).length > 0 && (
					<ul>
						{lines(plan.features).map((f) => (
							<li>{f}</li>
						))}
					</ul>
				)}
				<div class="bottom">
					{plan.price && <p class="price">{plan.price}</p>}
					{plan.priceNote && <p class="note">{plan.priceNote}</p>}
					{plan.buttonLabel && plan.buttonUrl && <Button href={plan.buttonUrl}>{plan.buttonLabel}</Button>}
				</div>
			</article>
		))
	}
</div>

<style>
	.plans {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 1.5rem;
	}

	.plan {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-top: 2px solid var(--color-energy);
		border-radius: var(--radius-button);
	}

	h3 {
		font-size: 1.5rem;
	}

	.description {
		color: var(--color-muted);
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		position: relative;
		padding-left: 1.5rem;
	}

	/* znaczek ✓ w kolorze energy */
	li::before {
		content: '';
		position: absolute;
		left: 0.15rem;
		top: 0.35em;
		width: 0.4rem;
		height: 0.75rem;
		border-right: 2px solid var(--color-energy);
		border-bottom: 2px solid var(--color-energy);
		transform: rotate(45deg);
	}

	.bottom {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}

	.price {
		font-family: var(--font-family-heading);
		font-size: 1.75rem;
		font-weight: var(--font-weight-h);
		color: var(--color-energy);
	}

	.note {
		margin-bottom: 1rem;
		color: var(--color-muted);
		font-size: 0.9rem;
	}
</style>
