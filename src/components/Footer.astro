---
import { info } from '../assets/data/kontakt';
import { Image } from 'astro:assets';
import iksLogo from '../images/logo_white_iks.png';
import instagramIcon from '@phosphor-icons/core/assets/regular/instagram-logo.svg?raw';
import facebookIcon from '@phosphor-icons/core/assets/regular/facebook-logo.svg?raw';
import youtubeIcon from '@phosphor-icons/core/assets/regular/youtube-logo.svg?raw';
import { getSiteConfig } from '../lib/datocms';

// linki do social mediów z CMS-u (model „Ustawienia strony”).
// Tymczasowo: ikony wyświetlają się zawsze — dopóki pole w CMS-ie jest
// puste, ikona prowadzi na stronę główną (external = prawdziwy link z CMS-u).
const config = await getSiteConfig();
// e-mail i telefon z CMS-u; plik assets/data/kontakt.js tylko jako zapas
const email = config?.email || info.mail;
const phone = config?.phone;
const company = [config?.companyName, config?.companyAddress?.replace(/\n+/g, ', '), config?.companyNip && `NIP ${config.companyNip}`]
	.filter(Boolean)
	.join(' · ');
const socials = [
	{ name: 'Instagram', url: config?.instagramUrl, icon: instagramIcon },
	{ name: 'Facebook', url: config?.facebookUrl, icon: facebookIcon },
	{ name: 'YouTube', url: config?.youtubeUrl, icon: youtubeIcon },
].map((s) => ({ ...s, external: Boolean(s.url), url: s.url || '/' }));

const legalLinks = [
	{ name: 'Regulamin', path: '/regulamin' },
	{ name: 'Polityka prywatności', path: '/polityka-prywatnosci' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer-main">
		<h2>Napisz do mnie!</h2>

		<a class="mail-link" href={`mailto:${email}`}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="2" y="4" width="20" height="16" rx="2"></rect>
				<path d="m22 7-10 6L2 7"></path>
			</svg>
			{email}
		</a>

		{phone && (
			<a class="mail-link" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path>
				</svg>
				{phone}
			</a>
		)}

		{
			socials.length > 0 && (
				<ul class="footer-social">
					{socials.map((s) => (
						<li>
							<a
								href={s.url}
								target={s.external ? '_blank' : undefined}
								rel={s.external ? 'noopener noreferrer' : undefined}
								aria-label={s.name}
								set:html={s.icon}
							/>
						</li>
					))}
				</ul>
			)
		}

		<ul class="footer-legal">
			{
				legalLinks.map((item) => (
					<li>
						<a href={item.path}>{item.name}</a>
					</li>
				))
			}
		</ul>
	</div>

	<div class="footer-credit">
		<hr />
		<span>&copy; {year} {info.imie}</span>
		{company && <span class="company">{company}</span>}
		<a href="https://iksdesign.pl/" target="_blank" rel="noopener noreferrer">
			<Image src={iksLogo} alt="" width={31} height={20} densities={[1, 2]} />
			IKS Design
		</a>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-footer);
		/* oddzielona linią od treści — tak jak pasek nawigacji */
		border-top: 1px solid var(--color-border);
		color: var(--color-white);
		text-align: center;
		padding-top: 3rem;
	}

	.footer-social {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		color: var(--color-white);
		border: 1px solid var(--color-border-strong);
		border-radius: 50%;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.footer-social a:hover {
		color: var(--color-on-energy);
		background: var(--color-energy);
		border-color: var(--color-energy);
	}

	.footer-social a :global(svg) {
		width: 1.35rem;
		height: 1.35rem;
	}

	.footer-main {
		max-width: 32rem;
		margin-inline: auto;
		padding: 0 1.5rem 2.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.footer-main h2 {
		color: var(--color-energy);
		font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
		line-height: 1.15;
		margin: 0;
	}

	.mail-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--color-white);
		text-decoration: none;
		font-weight: 600;
		transition: color 0.2s ease;
	}

	.mail-link:hover {
		color: var(--color-accent);
	}

	.mail-link svg {
		flex-shrink: 0;
		width: 1.1rem;
		height: 1.1rem;
	}

	.footer-legal {
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
		display: flex;
		gap: 1.5rem;
	}

	.footer-legal a {
		color: var(--color-white);
		opacity: 0.75;
		text-decoration: none;
		font-size: var(--font-size-label);
		transition: opacity 0.2s ease;
	}

	.footer-legal a:hover {
		opacity: 1;
	}

	.footer-credit {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		padding-bottom: 2rem;
	}

	.footer-credit hr {
		width: 100%;
		border: 0;
		border-top: 1px solid var(--color-border);
		margin: 0 0 0.85rem;
	}

	.footer-credit span,
	.footer-credit a {
		color: var(--color-white);
		opacity: 0.5;
		font-size: 0.8rem;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.footer-credit a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.footer-credit a img {
		display: block;
		width: auto;
		height: 20px;
	}

	.footer-credit a:hover {
		opacity: 0.85;
	}

	@media (max-width: 575px) {
		.footer-legal {
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
