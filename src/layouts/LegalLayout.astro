---
import BaseLayout from './BaseLayout.astro';
import SiteChrome from '../components/SiteChrome.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';

const { frontmatter } = Astro.props;
const heading = frontmatter.heading || frontmatter.title;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
	<SiteChrome>
		<Section pt={4} pb={3}>
			<Container>
				<h1 class="legal-heading">{heading}</h1>
			</Container>
		</Section>

		<Section pt={2} pb={6} bgcolor="var(--color-white)">
			<Container>
				<article class="prose">
					<slot />
				</article>
			</Container>
		</Section>
	</SiteChrome>
</BaseLayout>

<style>
	.legal-heading {
		max-width: 48rem;
		margin-inline: auto;
	}

	.prose {
		max-width: 48rem;
		margin-inline: auto;
	}

	.prose :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}

	.prose :global(p) {
		margin-bottom: 1rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose :global(li > ul),
	.prose :global(li > ol) {
		margin-top: 0.4rem;
	}

	.prose :global(a) {
		color: var(--color-base);
	}

	.prose :global(strong) {
		font-weight: var(--font-weight-bold);
	}
</style>
