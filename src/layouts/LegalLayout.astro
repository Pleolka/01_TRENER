---
// Regulamin i Polityka prywatności (pliki .md w src/pages) — całość
// w kroju tekstu (Montserrat), wyśrodkowana, mniejszą czcionką.
import BaseLayout from './BaseLayout.astro';
import SiteChrome from '../components/SiteChrome.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';

const { frontmatter } = Astro.props;
const heading = frontmatter.heading || frontmatter.title;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
	<SiteChrome>
		<Section pb={0}>
			<Container>
				<h1 class="legal-heading">{heading}</h1>
			</Container>
		</Section>

		<Section pt="var(--space-content)" bgcolor="var(--color-bg)">
			<Container>
				<article class="prose">
					<slot />
				</article>
			</Container>
		</Section>
	</SiteChrome>
</BaseLayout>

<style>
	.legal-heading,
	.prose,
	.prose :global(:is(h2, h3, h4)) {
		font-family: var(--font-family-body);
		text-align: center;
	}

	.legal-heading {
		font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
		font-weight: 700;
		line-height: 1.25;
	}

	/* bloki wyśrodkowane, linie tekstu do --measure */
	.prose :global(:is(p, ul, ol, h2, h3, h4)) {
		max-width: var(--measure);
		margin-inline: auto;
	}

	.prose :global(p),
	.prose :global(li) {
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.prose :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 1.75rem;
		margin-bottom: 0.75rem;
		font-size: 1rem;
		font-weight: 700;
	}

	.prose :global(p) {
		margin-bottom: 1rem;
	}

	/* listy wyśrodkowane razem z tekstem — punktory przy tekście, nie na marginesie */
	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 1rem;
		padding: 0;
		list-style-position: inside;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose :global(li > ul),
	.prose :global(li > ol) {
		margin-top: 0.4rem;
	}

	.prose :global(a) {
		color: var(--color-accent);
	}

	.prose :global(strong) {
		font-weight: var(--font-weight-bold);
	}
</style>
