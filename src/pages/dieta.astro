---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteChrome from '../components/SiteChrome.astro';
import PageHero from '../components/blocks/PageHero.astro';
import BlockSection from '../components/blocks/BlockSection.astro';
import FeatureGrid from '../components/blocks/FeatureGrid.astro';
import PlanCards from '../components/blocks/PlanCards.astro';
import OptionCards from '../components/blocks/OptionCards.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import FaqList from '../components/blocks/FaqList.astro';
import CtaBox from '../components/blocks/CtaBox.astro';
import Button from '../components/ui/Button.astro';
import { getDietPage } from '../lib/datocms';
import { faqPage, service } from '../lib/structuredData';
import { heroBackground } from '../lib/heroBackground';
import { accent } from '../lib/accent';
import bgImage from '../images/bg-ciezary-5.jpg';

// treści z modelu pojedynczego „Dieta” (diet_page) w DatoCMS
const page = await getDietPage();
const hero = await heroBackground(bgImage);

const jsonLd = page
	? [
			service(
				'Canela Diet — dieta w aplikacji',
				'Aplikacja dietetyczna z ponad 100 przepisami kuchni śródziemnomorskiej, listą zakupów i wymianą dań — dieta przeciwzapalna lub klasyczna w subskrypcji.',
				new URL('/dieta', Astro.site).toString(),
				page.plans.map((p) => ({ name: p.name, price: p.price })),
			),
			faqPage(page.faq),
		]
	: [];

const title = page?.seo?.title || 'Dieta';
const description = page?.seo?.description || 'Canela Diet — aplikacja dietetyczna z ponad 100 przepisami.';

const lines = (text: string | null) => (text ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
---

<BaseLayout title={title} description={description} image={page?.seo?.image?.url} jsonLd={jsonLd}>
	<SiteChrome {...hero}>
		{
			page && (
				<Fragment>
					<PageHero hero={page} />

					<BlockSection id="szczegoly" alt heading={page.benefitsHeading} lead={page.benefitsLead}>
						<FeatureGrid items={page.benefits} columns={3} icons />
					</BlockSection>

					<BlockSection
						id="wybierz-plan"
						heading={page.plansHeading}
						subheading={page.plansSubheading}
						lead={page.plansLead}
					>
						<PlanCards plans={page.plans} />
					</BlockSection>

					{/* „dla kogo”: zdjęcie po lewej, etykieta + nagłówek + lista z ptaszkami po prawej */}
					<BlockSection alt>
						<div class:list={['audience-layout', { 'has-image': page.audienceImage }]}>
							{page.audienceImage && (
								<span class="audience-photo">
									<img
										src={`${page.audienceImage.url}?w=900&h=1000&fit=crop&auto=format&q=80`}
										srcset={`${page.audienceImage.url}?w=540&h=600&fit=crop&auto=format&q=80 540w, ${page.audienceImage.url}?w=900&h=1000&fit=crop&auto=format&q=80 900w, ${page.audienceImage.url}?w=1260&h=1400&fit=crop&auto=format&q=80 1260w`}
										sizes="(max-width: 900px) 90vw, 45vw"
										alt={page.audienceImage.alt ?? ''}
										width="900"
										height="1000"
										loading="lazy"
									/>
								</span>
							)}
							<div class="audience-text stack">
								{page.audienceBadge && <p class="eyebrow">{page.audienceBadge}</p>}
								{page.audienceHeading && <h2 set:html={accent(page.audienceHeading)} />}
								<ul class="audience stack-gap">
									{lines(page.audienceItems).map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>
						</div>
					</BlockSection>

					<BlockSection heading={page.optionsHeading} lead={page.optionsLead}>
						<OptionCards options={page.options} />
					</BlockSection>

					<BlockSection alt heading={page.testimonialsHeading} lead={page.testimonialsLead}>
						<Testimonials items={page.testimonials} />
						{page.testimonialsButtonLabel && page.testimonialsButtonUrl && (
							<div class="after">
								<Button href={page.testimonialsButtonUrl}>{page.testimonialsButtonLabel}</Button>
							</div>
						)}
					</BlockSection>

					<BlockSection badge={page.faqBadge} heading={page.faqHeading}>
						<FaqList items={page.faq} />
					</BlockSection>

					<BlockSection alt>
						<CtaBox cta={page} />
					</BlockSection>
				</Fragment>
			)
		}
	</SiteChrome>
</BaseLayout>

<style>
	/* „dla kogo”: zdjęcie po lewej, treść po prawej; na telefonie zdjęcie nad treścią */
	.audience-layout.has-image {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 6rem);
	}

	@media (max-width: 900px) {
		.audience-layout.has-image {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* łagodny filtr marki — ten sam co zdjęcia w kartach */
	.audience-photo {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: var(--radius-button);
		isolation: isolate;
	}

	.audience-photo::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--tint-photo);
		mix-blend-mode: color;
		opacity: var(--tint-photo-soft-opacity);
		pointer-events: none;
	}

	.audience-photo img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 9 / 10;
		object-fit: cover;
		filter: var(--filter-photo-soft);
	}

	.audience-text {
		align-items: flex-start;
	}

	.audience-text :global(.accent) {
		color: var(--color-energy);
	}

	/* pionowa lista z ptaszkami w kolorze energy */
	.audience {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.audience li {
		position: relative;
		padding-left: 2.25rem;
		font-weight: 600;
	}

	.audience li::before {
		content: '';
		position: absolute;
		left: 0.4rem;
		top: 0.15em;
		width: 0.5rem;
		height: 0.9rem;
		border-right: 2px solid var(--color-energy);
		border-bottom: 2px solid var(--color-energy);
		transform: rotate(45deg);
	}

	.after {
		margin-top: 2.5rem;
	}
</style>
