---
import BaseLayout from '../layouts/BaseLayout.astro';
import CmsPage from '../components/CmsPage.astro';
import { getPageBySlug } from '../lib/datocms';

const page = await getPageBySlug('mocny-brzuch-w-6-tygodni');

const title = page?.seoTitle || 'Mocny brzuch w 6 tygodni';
const description =
	page?.seoDescription ||
	'Mocny brzuch w 6 tygodni — sześciotygodniowy plan treningowy na siłę i stabilizację mięśni brzucha.';
const heading = page?.heading || page?.title || 'Mocny brzuch w 6 tygodni';
const content = page?.content || '<p>Program treningowy — szczegóły już wkrótce.</p>';
---

<BaseLayout title={title} description={description}>
	<CmsPage heading={heading} eyebrow="Oferta" badge={page?.badge} content={content} />
</BaseLayout>
