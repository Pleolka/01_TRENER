---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/Home.astro';
import { getHomeContent, getHomeMeta } from '../lib/datocms';

// treści, zdjęcie hero i SEO z modelu pojedynczego „Strona główna” (home_content)
const [content, meta] = await Promise.all([getHomeContent(), getHomeMeta()]);

const title = meta?.seo?.title || 'Strona główna';
const description =
	meta?.seo?.description ||
	'Programy treningowe, dieta w aplikacji i prowadzenie 1:1 dla kobiet biznesu. Budowanie siły, kształtowanie sylwetki i zdrowe życie.';
---

<BaseLayout title={title} description={description} image={meta?.seo?.image?.url}>
	<Home content={content} heroImage={meta?.heroImage} />
</BaseLayout>
